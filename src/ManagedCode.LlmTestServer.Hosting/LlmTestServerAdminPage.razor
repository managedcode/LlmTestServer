<body data-renderer="blazor-ssr">
<LlmTestServerAdminPanel @rendermode="@(new InteractiveServerRenderMode())" />
<script src="_framework/blazor.web.js"></script>
<div id="viz-tip" class="viz-tip" role="tooltip" hidden></div>
<script>
  // Presentation only: follows pointer or keyboard focus and renders the element's data-tip text.
  (() => {
    const tip = document.getElementById("viz-tip");
    let current = null;
    const place = (x, y) => {
      const box = tip.getBoundingClientRect();
      const left = x + 16 + box.width > innerWidth - 8 ? x - box.width - 16 : x + 16;
      const top = y + 16 + box.height > innerHeight - 8 ? y - box.height - 16 : y + 16;
      tip.style.transform = "translate(" + Math.max(8, left) + "px, " + Math.max(8, top) + "px)";
    };
    const show = (element, x, y) => {
      const [head, ...lines] = element.getAttribute("data-tip").split("\n");
      const title = document.createElement("strong");
      title.textContent = head;
      tip.replaceChildren(title, ...lines.map(line => Object.assign(document.createElement("span"), { textContent: line })));
      const swatch = element.getAttribute("data-tip-color");
      tip.dataset.swatch = swatch ? "true" : "false";
      tip.style.setProperty("--tip-color", swatch || "transparent");
      tip.hidden = false;
      place(x, y);
    };
    const hide = () => { current = null; tip.hidden = true; };
    document.addEventListener("pointerover", event => {
      const element = event.target.closest ? event.target.closest("[data-tip]") : null;
      if (element === current) { return; }
      current = element;
      if (element) { show(element, event.clientX, event.clientY); } else { tip.hidden = true; }
    });
    document.addEventListener("pointermove", event => { if (current && !tip.hidden) { place(event.clientX, event.clientY); } });
    document.addEventListener("focusin", event => {
      const element = event.target.closest ? event.target.closest("[data-tip]") : null;
      if (!element) { return; }
      const box = element.getBoundingClientRect();
      current = element;
      show(element, box.left + box.width / 2, box.bottom);
    });
    document.addEventListener("focusout", hide);
    document.addEventListener("scroll", hide, true);
  })();
</script>
</body>
</html>
