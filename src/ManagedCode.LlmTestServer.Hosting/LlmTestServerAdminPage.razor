  .turn[data-response-card] { border-color: rgb(0 122 255 / 20%); background: linear-gradient(180deg, #fff, #f4f9ff); }
  .turn[data-response-card] .turn-content { max-height: 280px; overflow: auto; font-size: 14px; }
  .response-card-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .response-card-header > div { display: grid; gap: 1px; }
  .response-card-header > div > span { color: #8e8e93; font-size: 10px; }
  .thread-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 8px 2px 2px; }
  .thread-heading strong { color: #3a3a3c; font-size: 13px; font-weight: 600; }
  .thread-heading span { color: #8e8e93; font-size: 10px; }
  .turn-disclosure { padding: 0; }
  .turn-disclosure summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 9px;
    padding: 10px 12px;
    cursor: pointer;
    list-style: none;
  }
  .turn-disclosure summary::-webkit-details-marker { display: none; }
  .turn-preview { overflow: hidden; color: #6e6e73; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
  .turn-disclosure[open] .turn-content { max-height: 360px; margin: 0; padding: 12px; border-top: 1px solid var(--line-soft); overflow: auto; }

  .wire-grid { background: var(--line); }
  .payload-card { background: #f7f7f9; }
  .payload-head { border-bottom-color: var(--line); color: #6e6e73; font-size: 10px; font-weight: 600; letter-spacing: 0; }
  .payload-content { color: #2c2c2e; font-size: 11px; line-height: 1.55; }
  .chunk { border-bottom-color: var(--line-soft); }
  .chunk-index { color: #8e8e93; font-size: 10px; }
  .chunk-content { color: #3a3a3c; font-size: 12px; }
  .runtime-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; padding: 14px; }
  .meta-card { border: 0; border-radius: 12px; background: rgb(118 118 128 / 7%); }
  .meta-value { color: #3a3a3c; font-size: 11px; }
  .runtime-note { border: 0; border-radius: 12px; background: rgb(118 118 128 / 7%); }
  .runtime-note p { color: #3a3a3c; }

  .diagnostics-sheet {
    top: 38px;
    right: 0;
    width: min(520px, calc(100vw - 24px));
    max-height: calc(100vh - 66px);
    border: 1px solid rgb(60 60 67 / 16%);
    border-radius: 16px;
    background: rgb(250 250 252 / 97%);
    color: #1d1d1f;
    box-shadow: 0 18px 54px rgb(0 0 0 / 18%);
    backdrop-filter: saturate(180%) blur(30px);
  }
  .diagnostics-header { border-bottom-color: var(--line); }
  .diagnostics-header .eyebrow { color: #8e8e93; }
  .retention-note { color: #8e8e93; }
  .runtime-settings { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 10px; padding: 11px 12px; border-bottom: 1px solid var(--line); background: rgb(242 242 247 / 92%); }
  .settings-token { display: grid; gap: 4px; color: #6e6e73; font-size: 10px; font-weight: 600; }
  .settings-token input { width: 100%; height: 34px; padding: 0 9px; border-radius: 5px; }
  .diagnostics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); background: transparent; }
  .diagnostic-card { border-color: rgb(60 60 67 / 12%); border-radius: 12px; background: rgb(255 255 255 / 96%); }
  .diagnostic-card h3 { border-bottom-color: var(--line-soft); color: #3a3a3c; font-size: 11px; }
  .diagnostic-card:last-child { grid-column: span 2; }
  .diagnostic-row { border-top-color: var(--line-soft); }
  .diagnostic-primary { color: #3a3a3c; font-size: 12px; }
  .diagnostic-secondary { color: #8e8e93; font-size: 11px; }
  .diagnostic-empty { color: #8e8e93; }
  .runtime-dialog-trigger { gap: 7px; }
  .runtime-fluent-dialog {
    display: contents;
    --runtime-dialog-width: min(980px, calc(100vw - 32px));
    --runtime-dialog-height: min(760px, calc(100dvh - 48px));
    --dialog-backdrop: rgb(10 10 12 / 20%);
  }
  .runtime-fluent-dialog::part(dialog)::backdrop {
    background: var(--dialog-backdrop);
    backdrop-filter: blur(8px) saturate(140%);
  }
  .runtime-fluent-dialog::part(dialog) {
    --dialog-padding: 0px;
    box-sizing: border-box;
    width: var(--runtime-dialog-width) !important;
    height: var(--runtime-dialog-height) !important;
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 48px);
    padding: 0;
    border: 1px solid rgb(255 255 255 / 72%);
    border-radius: 18px;
    background: rgb(250 250 252 / 96%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 92%),
      0 22px 60px -12px rgb(10 10 12 / 24%);
    backdrop-filter: blur(36px) saturate(180%);
    overflow: hidden;
  }
  .runtime-fluent-dialog .diagnostics-sheet {
    position: static;
    width: 100%;
    height: 100%;
    max-height: none;
    overflow: auto;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }
  .runtime-fluent-dialog .diagnostics-header {
    position: sticky;
    z-index: 3;
    top: 0;
    background: rgb(250 250 252 / 94%);
    backdrop-filter: blur(24px) saturate(160%);
  }
  .dialog-header-actions { display: flex; align-items: center; gap: 10px; }
  .dialog-close {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(118 118 128 / 10%);
    color: #6e6e73;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
  }
  .dialog-close:hover { background: rgb(118 118 128 / 18%); color: #1d1d1f; }

  /* Brand layer: Prostir technical polish × Managed Code editorial warmth. */
  :root {
    --canvas: #f9f7f5;
    --pane-selected: rgb(164 242 88 / 14%);
    --line: rgb(22 22 22 / 13%);
    --line-soft: rgb(22 22 22 / 8%);
    --text: #161616;
    --text-soft: #363432;
    --muted: rgb(18 18 18 / 60%);
    --accent: #a4f258;
    --accent-strong: #83cc3c;
    --green: #3f8d55;
    --red: #c94f3d;
    --amber: #946a17;
    --brand-coral: #ff7e5d;
    --brand-magenta: #db3276;
  }
  html, body { background: #f9f7f5; }
  body { color: #161616; }
  button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible {
    box-shadow: 0 0 0 2px #fff, 0 0 0 5px rgb(164 242 88 / 72%);
  }
  .shell {
    background:
      radial-gradient(700px 440px at 4% -12%, rgb(164 242 88 / 10%), transparent 62%),
      radial-gradient(660px 420px at 97% -18%, rgb(255 126 93 / 8%), transparent 58%),
      #f9f7f5;
  }
  .topbar {
    position: relative;
    border-bottom-color: rgb(22 22 22 / 10%);
    background:
      linear-gradient(135deg, rgb(255 255 255 / 80%), rgb(249 247 245 / 78%)),
      rgb(249 247 245 / 84%);
  }
  .topbar::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent 2%, rgb(164 242 88 / 82%) 28%, rgb(219 50 118 / 58%) 66%, rgb(237 115 46 / 62%) 84%, transparent 98%);
    pointer-events: none;
  }
  .brand-mark {
    position: relative;
    background: linear-gradient(145deg, #2a2a2a, #121212 72%);
    color: #fff;
    box-shadow: 0 4px 12px rgb(22 22 22 / 16%), inset 0 1px rgb(255 255 255 / 18%);
  }
  .brand-mark::after {
    content: "";
    position: absolute;
    top: 5px;
    right: 5px;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: #a4f258;
    box-shadow: 0 0 0 1px rgb(164 242 88 / 22%);
  }
  .brand h1 { color: #161616; font-weight: 700; letter-spacing: -.025em; }
  .toolbar-button.accent {
    background: #a4f258;
    color: #121212;
    box-shadow: 0 5px 16px rgb(105 156 53 / 18%), inset 0 1px rgb(255 255 255 / 42%);
  }
  .toolbar-button.accent:hover { background: #b2fa68; color: #121212; }
  .runtime-dialog-trigger { background: #161616; color: #fff; }
  .runtime-dialog-trigger:hover { background: #2a2928; color: #fff; }
  .auto-toggle input { accent-color: #83cc3c; }
  .connection.ok .status-dot { background: #5bc97a; }
  .connection.warn .status-dot { background: #e8b445; }
  .connection.err .status-dot { background: #e87c66; }

  .nav-rail { background: rgb(242 237 232 / 82%); }
  .rail-item.selected {
    background: rgb(164 242 88 / 20%);
    color: #263a14;
    box-shadow: inset 3px 0 #a4f258;
  }
  .rail-clear { color: #9f382b; }
  .rail-icon.cache { color: #346d82; background: rgb(95 182 220 / 14%); }
  .provider-dot { background: #a4f258; box-shadow: 0 0 0 1px rgb(22 22 22 / 18%); }
  .rail-select select,
  .search-field input,
  .compact-filters select,
  .settings-token input { border-color: rgb(22 22 22 / 13%); }

  .request-inbox,
  .reading-pane { background: rgb(255 255 255 / 94%); }
  .inbox-header,
  .reading-header {
    border-bottom-color: rgb(22 22 22 / 10%);
    background: linear-gradient(135deg, rgb(255 255 255 / 88%), rgb(255 248 244 / 58%));
  }
  .inbox-header h2,
  .reading-header h2,
  .diagnostics-header h2 { color: #161616; font-weight: 700; letter-spacing: -.025em; }
  .provider-avatar {
    background: linear-gradient(145deg, #30302f, #111 75%);
    color: #a4f258;
    box-shadow: inset 0 1px rgb(255 255 255 / 14%);
  }
  .inbox-item.selected {
    background: linear-gradient(90deg, rgb(164 242 88 / 19%), rgb(255 255 255 / 98%) 38%);
    color: #161616;
    box-shadow: inset 3px 0 #a4f258;
  }
  .inbox-item.selected::before { background: #a4f258; }
  .inbox-item.selected .inbox-identity strong,
  .inbox-item.selected .inbox-model,
  .inbox-item.selected .inbox-preview,
  .inbox-item.selected .inbox-endpoint .mono,
  .inbox-item.selected .inbox-stat,
  .inbox-item.selected time { color: #242321; }
  .inbox-item.selected .inbox-endpoint .mono,
  .inbox-item.selected .inbox-stat,
  .inbox-item.selected time { color: rgb(18 18 18 / 60%); }
  .inbox-item.selected .inbox-stat.cache { color: #4d781e; }
  .inbox-item.selected .provider-avatar {
    background: #161616;
    color: #a4f258;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 12%);
  }
  .inbox-item.selected .method-chip { background: rgb(137 68 171 / 10%); color: #71398c; }
  .inbox-item.selected .status-chip.success { background: rgb(91 201 122 / 16%); color: #337c49; }
  .inbox-item.selected .status-chip.error { background: rgb(232 124 102 / 15%); color: #b83f31; }
  .inbox-item.selected .mode-chip { background: rgb(219 50 118 / 10%); color: #a3255b; }
  .provider-chip { background: rgb(164 242 88 / 22%); color: #365b16; }
  .inbox-stat.cache { color: #4d781e; }
  .status-chip.success { background: rgb(91 201 122 / 15%); color: #337c49; }
  .status-chip.error { background: rgb(232 124 102 / 14%); color: #b83f31; }
  .status-chip.warning { background: rgb(232 180 69 / 16%); color: #836018; }

  .facts-strip { background: rgb(242 237 232 / 72%); }
  .detail-tab { position: relative; }
  .detail-tab.selected::after {
    content: "";
    position: absolute;
    right: 8px;
    bottom: 2px;
    left: 8px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, #db3276, #ed732e);
  }
  .overview-grid,
  .conversation-scroll { background: #f9f7f5; }
  .overview-card { border-color: rgb(22 22 22 / 10%); }
  .response-overview {
    position: relative;
    background: linear-gradient(135deg, #fff 44%, rgb(255 126 93 / 5%), rgb(219 50 118 / 3.5%));
  }
  .response-overview::before {
    content: "";
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, #a4f258, #ff7e5d 60%, #db3276);
  }
  .overview-kicker { color: #a63b2a; }
  .turn[data-response-card] {
    border-color: rgb(164 242 88 / 46%);
    background: linear-gradient(135deg, #fff, rgb(164 242 88 / 7%), rgb(255 126 93 / 4%));
  }
  .payload-card { background: #f7f3ef; }
  .meta-card,
  .runtime-note { background: rgb(242 237 232 / 72%); }

  .runtime-fluent-dialog::part(dialog) {
    border-color: rgb(255 255 255 / 88%);
    background: rgb(249 247 245 / 96%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 94%),
      0 24px 70px -16px rgb(22 22 22 / 30%);
  }
  .runtime-fluent-dialog .diagnostics-header {
    position: sticky;
    background: rgb(249 247 245 / 94%);
  }
  .runtime-fluent-dialog .diagnostics-header::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, #a4f258, #db3276 64%, #ed732e);
    opacity: .72;
  }
  .runtime-settings { background: rgb(242 237 232 / 78%); }
  .diagnostic-card { border-color: rgb(22 22 22 / 10%); background: rgb(255 255 255 / 88%); }
  .dialog-close { background: #161616; color: #fff; }
  .dialog-close:hover { background: #a4f258; color: #161616; }

  @@media (max-width: 1439px) {
    .mail-workspace { grid-template-columns: 184px 360px minmax(0, 1fr); }
    .nav-rail { display: flex; }
    .compact-filters { display: none; }
    .wire-grid { grid-template-columns: 1fr; grid-template-rows: repeat(2, minmax(300px, 1fr)); overflow: auto; }
  }

  @@media (max-width: 1099px) {
    .mail-workspace { grid-template-columns: 350px minmax(0, 1fr); }
    .nav-rail { display: none; }
    .compact-filters { display: grid; grid-template-columns: 1fr 1fr; }
    .compact-filters select:last-of-type { grid-column: 1 / -1; }
    .inbox-tools { gap: 7px; }
    .runtime-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @@media (max-width: 900px) {
    .mail-workspace { grid-template-columns: 330px minmax(0, 1fr); }
    .facts-strip { grid-template-columns: 66px 76px 116px minmax(110px, 1fr); }
    .fact:last-child { display: none; }
  }

  @@media (max-width: 767px) {
    .shell { grid-template-rows: 48px minmax(0, 1fr); }
    .topbar { padding: 0 8px; }
    .brand { min-width: 0; }
    .brand-full { display: none; }
    .brand-short { display: inline; }
    .brand h1 { font-size: 14px; }
    .command-bar { gap: 4px; }
    .connection { min-width: 28px; padding: 0 7px; }
    .auto-toggle { min-width: 32px; padding: 0 7px; }
    .command-bar > .toolbar-button.accent { width: 34px; padding: 0; }
    .command-bar > .toolbar-button.accent span:last-child { display: none; }
    .runtime-dialog-trigger { width: 34px; padding: 0; font-size: 12px; }
    .runtime-dialog-trigger span:first-child { display: none; }
    .runtime-fluent-dialog {
      --runtime-dialog-width: calc(100vw - 12px);
      --runtime-dialog-height: calc(100dvh - 12px);
    }
    .runtime-fluent-dialog::part(dialog) {
      max-width: calc(100vw - 12px);
      max-height: calc(100dvh - 12px);
      border-radius: 18px;
    }
    .mail-workspace { grid-template-columns: minmax(0, 1fr); }
    .mobile-list .reading-pane { display: none; }
    .mobile-reading .request-inbox { display: none; }
    .inbox-header { min-height: 58px; }
    .inbox-item { min-height: 86px; }
    .reading-header { min-height: 68px; padding: 10px 12px; }
    .facts-strip { grid-template-columns: repeat(4, minmax(92px, 1fr)); overflow-x: auto; }
    .fact:last-child { display: none; }
    .overview-grid { grid-template-columns: 1fr; grid-template-rows: minmax(220px, 42%) minmax(0, 1fr); overflow: hidden; }
    .response-overview { order: -1; }
    .overview-card-header { min-height: 46px; }
    .response-body { padding: 16px; }
    .response-copy { font-size: 14px; }
    .conversation-scroll { padding: 12px; }
    .thread-heading { display: grid; }
    .wire-grid { grid-template-columns: 1fr; grid-template-rows: repeat(2, minmax(320px, 1fr)); overflow: auto; scroll-snap-type: none; }
    .payload-card { scroll-snap-align: none; }
    .diagnostics-sheet { top: 54px; right: 8px; left: 8px; width: auto; max-height: calc(100vh - 62px); }
    .diagnostics-grid { grid-template-columns: 1fr; }
    .diagnostic-card:last-child { grid-column: auto; }
    .runtime-settings { grid-template-columns: 1fr; }
  }

  @@media (max-width: 480px) {
    .compact-filters { grid-template-columns: 1fr 1fr; }
    .compact-filters select:first-child { grid-column: 1 / -1; }
    .inbox-meta-row { grid-template-columns: minmax(80px, 1fr) auto; }
    .inbox-item-bottom .inbox-stat:nth-of-type(n + 3) { display: none; }
    .reading-title h2 { font-size: 17px; }
    .detail-tabs { padding-left: 7px; padding-right: 7px; }
    .detail-tab { padding: 0 8px; }
  }
</style>
</head>
<body data-renderer="blazor-ssr">
<LlmTestServerAdminPanel @rendermode="@(new InteractiveServerRenderMode())" />
