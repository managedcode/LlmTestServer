  .anatomy-server strong { color: #a4f258; }
  .anatomy-link { position: relative; height: 2px; margin: 0 8px; background: repeating-linear-gradient(90deg, #161616 0 6px, transparent 6px 11px); }
  .anatomy-link::after { content: ""; position: absolute; top: -5px; right: -4px; border: 6px solid transparent; border-left-color: #161616; }
  .anatomy-link span { position: absolute; top: -26px; left: 50%; padding: 2px 8px; border: 1px solid rgb(22 22 22 / 10%); border-radius: 999px; background: #fff; color: #161616; font-size: 10px; font-weight: 650; transform: translateX(-50%); white-space: nowrap; }
  .anatomy-link.failed { background: repeating-linear-gradient(90deg, #c94f3d 0 6px, transparent 6px 11px); }
  .anatomy-link.failed::after { border-left-color: #c94f3d; }
  .anatomy-link.failed span { color: #c94f3d; }
  .diagnostics-charts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding: 10px 10px 0; }
  .diagnostics-charts > .viz-card { display: flex; flex-direction: column; margin: 0; padding: 14px; }
  .diagnostics-charts .insight-donut .donut { width: 112px; height: 112px; }
  .event-strip { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 14px; }
  .event-dot { display: inline-block; width: 11px; height: 11px; border-radius: 50%; background: #3f8d55; }
  .event-dot.warning { background: #e8b445; }
  .event-dot.error { background: #c94f3d; }
  .viz-legend i.event-dot { border-radius: 50%; }
  @@container (max-width: 560px) {
    .anatomy { grid-template-columns: minmax(0, 1fr); row-gap: 34px; }
    .anatomy-link { justify-self: center; width: 2px; height: 26px; margin: -18px 0; background: repeating-linear-gradient(180deg, #161616 0 6px, transparent 6px 11px); }
    .anatomy-link::after { top: auto; right: -5px; bottom: -6px; border: 6px solid transparent; border-top-color: #161616; border-left-color: transparent; }
    .anatomy-link span { top: 50%; left: 14px; transform: translateY(-50%); }
    .msg-meter-bar { width: 40px; }
  }
  @@media (max-width: 767px) {
    .diagnostics-charts { grid-template-columns: minmax(0, 1fr); }
  }

  /* Tooltips, highlighted JSON and tool-call cards. */
  .viz-tip { position: fixed; z-index: 1000; top: 0; left: 0; display: grid; gap: 2px; min-width: 120px; max-width: 300px; padding: 9px 12px 10px; border-radius: 12px; background: rgb(22 22 22 / 94%); color: #f4efe6; box-shadow: 0 14px 36px rgb(0 0 0 / 24%); font-size: 11.5px; line-height: 1.45; pointer-events: none; backdrop-filter: blur(10px); }
  .viz-tip[hidden] { display: none; }
  .viz-tip strong { display: flex; align-items: center; gap: 7px; color: #fff; font-size: 12px; font-weight: 650; }
  .viz-tip strong::before { content: ""; flex: none; width: 9px; height: 9px; border-radius: 3px; background: var(--tip-color, transparent); }
  .viz-tip[data-swatch="false"] strong::before { display: none; }
  .viz-tip span { color: rgb(244 239 230 / 74%); font-variant-numeric: tabular-nums; }
  [data-tip] { cursor: default; }
  button[data-tip], .recent-column, .capsule { cursor: pointer; }
  .response-json, .payload-content, .tool-call-args { color: #9a948d; }
  .j-key { color: #2b5fa8; }
  .j-str { color: #3d7a1c; }
  .j-num { color: #c2512b; }
  .j-lit { color: #6250d6; font-weight: 600; }
  .tool-call-cards { display: grid; gap: 10px; }
  .tool-call-card { overflow: hidden; border: 1px solid rgb(22 22 22 / 9%); border-radius: 14px; background: #fff; }
  .tool-call-card header { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid var(--line-soft); }
  .tool-call-glyph { display: grid; flex: none; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: color-mix(in srgb, var(--mix-tool-calls) 14%, #fff); color: var(--mix-tool-calls); font-size: 15px; font-style: italic; font-weight: 700; }
  .tool-call-card header strong { color: #161616; font-size: 13px; }
  .tool-call-card header span:last-child { margin-left: auto; overflow: hidden; color: #8e8a86; font-size: 10.5px; text-overflow: ellipsis; white-space: nowrap; }
  .tool-call-args { margin: 0; padding: 12px 14px; background: #faf8f5; font-family: "SFMono-Regular", "SF Mono", ui-monospace, Menlo, monospace; font-size: 12px; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
  .raw-json { margin-top: 4px; }
  .raw-json summary { color: #8e8a86; cursor: pointer; font-size: 11.5px; }
  .raw-json[open] .response-json { margin-top: 10px; }
  .tool-json { margin: 6px 0 0; padding: 10px 12px; border-radius: 10px; background: #faf8f5; color: #9a948d; font-family: "SFMono-Regular", "SF Mono", ui-monospace, Menlo, monospace; font-size: 12px; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
