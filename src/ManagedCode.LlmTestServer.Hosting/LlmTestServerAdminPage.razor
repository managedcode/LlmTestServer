  .chunk-chart { display: flex; flex: 0 0 auto; align-items: flex-end; gap: 3px; height: 76px; margin: 12px 14px 0; padding-bottom: 8px; border-bottom: 1px solid var(--line-soft); overflow: hidden; }
  .chunk-chart > span { display: flex; flex: 1 1 0; align-items: flex-end; justify-content: center; min-width: 2px; height: 100%; }
  .chunk-chart > span > span { display: block; width: min(100%, 36px); border-radius: 5px 5px 1px 1px; background: var(--mix-assistant); }
  .anatomy { display: grid; grid-template-columns: minmax(0, 1fr) 70px minmax(0, 1.1fr) 70px minmax(0, 1fr); align-items: center; margin: 22px 14px 6px; }
  .anatomy-node { display: grid; gap: 2px; min-width: 0; padding: 12px 14px; border: 1px solid rgb(22 22 22 / 9%); border-radius: 14px; background: #fff; }
  .anatomy-node span, .anatomy-node em { overflow: hidden; color: #8e8a86; font-size: 10.5px; font-style: normal; text-overflow: ellipsis; white-space: nowrap; }
  .anatomy-node strong { color: #161616; font-size: 17px; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .anatomy-server { border-color: #161616; background: #161616; }
