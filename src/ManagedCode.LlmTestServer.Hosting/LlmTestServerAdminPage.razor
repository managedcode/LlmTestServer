@namespace ManagedCode.LlmTestServer.Hosting
@page "/"
@using Microsoft.AspNetCore.Components.Web

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="generator" content="Blazor SSR">
<link rel="icon" href="data:,">
<title>LLM Test Server · Request dashboard</title>
<style>
  :root {
    color-scheme: dark;
    --canvas: #070a0f;
    --pane: #0b1018;
    --pane-raised: #101722;
    --pane-selected: #14231f;
    --hover: #111b28;
    --line: #202c3c;
    --line-soft: rgb(32 44 60 / 62%);
    --text: #f3f6fa;
    --text-soft: #c3cdda;
    --muted: #8090a3;
    --accent: #68dfb8;
    --accent-strong: #2fc798;
    --blue: #79aaff;
    --green: #61d89c;
    --red: #ff7e88;
    --amber: #edb45e;
    --violet: #b39cff;
  }

  * { box-sizing: border-box; }
  html, body { width: 100%; height: 100%; }
  html { background: var(--canvas); }
  body {
    margin: 0;
    min-width: 320px;
    overflow: hidden;
    background: var(--canvas);
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.42;
    -webkit-font-smoothing: antialiased;
  }

  button, input, select, summary { font: inherit; }
  button, input, select, summary { outline: none; }
  button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible {
    box-shadow: 0 0 0 2px var(--canvas), 0 0 0 4px rgb(104 223 184 / 62%);
  }
  code, pre, .mono { font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .shell {
    position: relative;
    display: grid;
    grid-template-rows: 58px minmax(0, 1fr);
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 8% -20%, rgb(47 199 152 / 8%), transparent 30rem),
      var(--canvas);
  }

  .topbar {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-width: 0;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
    background: rgb(7 10 15 / 94%);
    backdrop-filter: blur(16px);
  }
  .brand { display: flex; align-items: center; gap: 10px; min-width: 170px; }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid rgb(104 223 184 / 45%);
    border-radius: 8px;
    background: rgb(104 223 184 / 10%);
    color: var(--accent);
    font-weight: 900;
  }
  .brand-copy { min-width: 0; }
  .brand h1 { margin: 1px 0 0; font-size: 15px; line-height: 1.1; letter-spacing: -.02em; }
  .eyebrow {
    color: var(--muted);
    font-size: 9px;
    font-weight: 850;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .command-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    min-width: 0;
  }
  .header-token input,
  .search-field input,
  .compact-filters select,
  .rail-select select {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: #080c12;
    color: var(--text);
  }
  .header-token { width: clamp(140px, 17vw, 230px); }
  .header-token input { height: 34px; padding: 0 10px; font-size: 12px; }
  input::placeholder { color: #5e6d80; }
  .toolbar-button,
  .auto-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--pane-raised);
    color: var(--text-soft);
    cursor: pointer;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }
  .toolbar-button:hover, .auto-toggle:hover { border-color: #3c4b61; background: var(--hover); }
  .toolbar-button.accent { border-color: rgb(104 223 184 / 58%); color: var(--accent); }
  .toolbar-button.danger:hover { border-color: rgb(255 126 136 / 62%); color: var(--red); }
  .toolbar-button:disabled { opacity: .45; cursor: not-allowed; }
  .auto-toggle { gap: 6px; user-select: none; }
  .auto-toggle input { accent-color: var(--accent-strong); }

  .connection {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); }
  .connection.ok .status-dot { background: var(--green); box-shadow: 0 0 10px rgb(97 216 156 / 70%); }
  .connection.warn .status-dot { background: var(--amber); }
  .connection.err .status-dot { background: var(--red); }

  .notice {
    display: none;
    position: fixed;
    z-index: 50;
    top: 66px;
    left: 50%;
    width: min(560px, calc(100vw - 28px));
    padding: 10px 12px;
    transform: translateX(-50%);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #111923;
    color: var(--text-soft);
    box-shadow: 0 18px 48px rgb(0 0 0 / 42%);
    font-size: 12px;
  }
  .notice.show { display: block; }
  .notice.err { border-color: rgb(255 126 136 / 60%); color: var(--red); }
  .notice.warn { border-color: rgb(237 180 94 / 60%); color: var(--amber); }

  .mail-workspace {
    display: grid;
    grid-template-columns: 188px minmax(360px, 410px) minmax(520px, 1fr);
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .nav-rail,
  .request-inbox,
  .reading-pane {
    min-width: 0;
    min-height: 0;
    background: var(--pane);
  }
  .nav-rail {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
    background: #090e15;
  }
  .rail-scroll { min-height: 0; overflow: auto; padding: 12px 9px; }
  .rail-section { padding: 4px 0 13px; border-bottom: 1px solid var(--line-soft); }
  .rail-section + .rail-section { padding-top: 13px; }
  .rail-section:last-child { border-bottom: 0; }
  .rail-heading {
    margin: 0 8px 7px;
    color: var(--muted);
    font-size: 9px;
    font-weight: 850;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .rail-section-title { display: flex; align-items: center; justify-content: space-between; }
  .rail-clear {
    margin: 0 7px 6px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent);
    cursor: pointer;
    font-size: 10px;
  }
  .rail-item {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    align-items: center;
    gap: 7px;
    width: 100%;
    min-height: 34px;
    padding: 5px 8px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    text-align: left;
    font-size: 11px;
  }
  .rail-item:hover { background: var(--hover); }
  .rail-item.selected { background: rgb(104 223 184 / 10%); color: var(--text); }
  .rail-item strong { color: var(--muted); font-size: 10px; font-variant-numeric: tabular-nums; }
  .rail-icon {
    display: grid;
    place-items: center;
    width: 19px;
    height: 19px;
    border-radius: 5px;
    background: rgb(128 144 163 / 10%);
    color: var(--muted);
    font-size: 10px;
    font-weight: 900;
  }
  .rail-icon.success { color: var(--green); }
  .rail-icon.error { color: var(--red); }
  .rail-icon.stream { color: var(--violet); }
  .rail-icon.cache { color: var(--accent); }
  .rail-item.provider { grid-template-columns: 10px minmax(0, 1fr) auto; }
  .provider-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }
  .rail-empty { padding: 8px; color: var(--muted); font-size: 10px; }
  .rail-select { display: grid; gap: 6px; }
  .rail-select select { height: 34px; padding: 0 8px; font-size: 11px; }
  .clear-filters {
    width: 100%;
    margin-top: 8px;
    padding: 7px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 10px;
  }
  .rail-footer {
    display: grid;
    gap: 2px;
    margin-top: auto;
    padding: 10px 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 9px;
  }

  .request-inbox {
    display: grid;
    grid-template-rows: auto auto auto minmax(0, 1fr);
    border-right: 1px solid var(--line);
  }
  .inbox-header,
  .reading-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--pane-raised);
  }
  .inbox-header h2, .reading-header h2, .diagnostics-header h2 {
    margin: 0;
    font-size: 14px;
    letter-spacing: -.015em;
  }
  .inbox-header p { margin: 2px 0 0; color: var(--muted); font-size: 10px; }
  .count-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 22px;
    padding: 0 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 10px;
    font-weight: 850;
  }
  .inbox-tools { display: grid; gap: 7px; padding: 9px 10px; border-bottom: 1px solid var(--line-soft); }
  .search-field input { height: 34px; padding: 0 10px; font-size: 11px; }
  .compact-filters { display: none; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 6px; }
  .compact-filters select { min-width: 0; height: 32px; padding: 0 7px; font-size: 10px; }
  .compact-filters .toolbar-button { min-height: 32px; }
  .inbox-columns {
    display: grid;
    grid-template-columns: 1fr auto;
    padding: 7px 12px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 8px;
    font-weight: 850;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .inbox-list { min-height: 0; overflow: auto; }
  .inbox-item {
    position: relative;
    display: grid;
    gap: 5px;
    width: 100%;
    min-height: 92px;
    padding: 10px 12px 10px 14px;
    border: 0;
    border-bottom: 1px solid var(--line-soft);
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    text-align: left;
  }
  .inbox-item::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: transparent;
  }
  .inbox-item:hover { background: var(--hover); }
  .inbox-item.selected { background: var(--pane-selected); }
  .inbox-item.selected::before { background: var(--accent); }
  .inbox-item-top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 7px;
  }
  .inbox-item-top time { color: var(--muted); font-size: 9px; font-variant-numeric: tabular-nums; }
  .inbox-model { overflow: hidden; color: var(--text); font-size: 11px; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
  .inbox-endpoint { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 6px; }
  .inbox-endpoint .mono { overflow: hidden; color: var(--text-soft); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
  .inbox-operation { overflow: hidden; color: var(--muted); font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
  .inbox-item-bottom { display: flex; align-items: center; gap: 7px; min-width: 0; overflow: hidden; }
  .inbox-stat { color: var(--muted); font-size: 9px; white-space: nowrap; }
  .inbox-stat.cache { color: var(--accent); }

  .provider-chip, .status-chip, .method-chip, .mode-chip {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    border: 1px solid var(--chip-tone, var(--line));
    background: color-mix(in srgb, var(--chip-tone, var(--muted)) 10%, transparent);
    color: var(--chip-tone, var(--text-soft));
    white-space: nowrap;
  }
  .provider-chip { --chip-tone: var(--blue); padding: 2px 6px; border-radius: 5px; font-size: 9px; font-weight: 850; }
  .method-chip { --chip-tone: var(--violet); padding: 1px 4px; border-radius: 4px; font-size: 8px; font-weight: 900; }
  .status-chip { padding: 2px 6px; border-radius: 999px; font-size: 9px; font-weight: 850; }
  .status-chip.success { --chip-tone: var(--green); }
  .status-chip.error { --chip-tone: var(--red); }
  .status-chip.warning { --chip-tone: var(--amber); }
  .mode-chip { --chip-tone: var(--violet); padding: 1px 5px; border-radius: 999px; font-size: 8px; font-weight: 850; }

  .reading-pane {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #0a0f17;
  }
  .reading-header { flex: 0 0 auto; align-items: flex-start; padding: 12px 15px; }
  .reading-title { min-width: 0; flex: 1 1 auto; }
  .reading-eyebrow { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; flex-wrap: wrap; }
  .reading-title h2 { font-size: 17px; }
  .reading-route { margin-top: 3px; overflow: hidden; color: var(--muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
  .reading-id { max-width: 210px; overflow: hidden; color: var(--muted); font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
  .mobile-back { display: none; }
  .reading-empty, .empty-state {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 32px;
    color: var(--muted);
    text-align: center;
  }
  .reading-empty { height: 100%; }
  .reading-empty strong, .empty-state strong { display: block; margin-top: 8px; color: var(--text-soft); }
  .reading-empty span, .empty-state span { display: block; margin-top: 4px; font-size: 11px; }
  .reading-empty-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin: auto;
    border: 1px solid var(--line);
    border-radius: 9px;
    color: var(--accent);
  }

  .reading-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    flex: 0 0 auto;
    border-bottom: 1px solid var(--line-soft);
    background: #090e15;
  }
  .summary-item { min-width: 0; padding: 8px 10px; border-right: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); }
  .summary-item:nth-child(3n) { border-right: 0; }
  .summary-item:nth-last-child(-n + 3) { border-bottom: 0; }
  .summary-item span, .meta-label, .usage-label {
    display: block;
    color: var(--muted);
    font-size: 8px;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .summary-item strong { display: block; margin-top: 3px; overflow: hidden; color: var(--text-soft); font-size: 10px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }

  .usage-strip {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    flex: 0 0 auto;
    border-bottom: 1px solid var(--line);
  }
  .usage-cell { min-width: 0; padding: 7px 9px; border-right: 1px solid var(--line-soft); }
  .usage-cell:last-child { border-right: 0; }
  .usage-value { margin-top: 2px; color: var(--text); font-size: 13px; font-weight: 850; font-variant-numeric: tabular-nums; }
  .usage-cell.cache .usage-value { color: var(--accent); }
  .usage-cell.reasoning .usage-value { color: var(--amber); }

  .detail-tabs {
    display: flex;
    flex: 0 0 auto;
    gap: 2px;
    padding: 6px 10px 0;
    border-bottom: 1px solid var(--line);
    background: var(--pane);
    overflow-x: auto;
  }
  .detail-tab {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 34px;
    padding: 0 10px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 10px;
    font-weight: 800;
    white-space: nowrap;
  }
  .detail-tab span { min-width: 18px; padding: 1px 5px; border-radius: 999px; background: var(--pane-raised); font-size: 8px; }
  .detail-tab:hover { color: var(--text-soft); }
  .detail-tab.selected { border-bottom-color: var(--accent); color: var(--text); }

  .detail-panels { flex: 1 1 auto; min-height: 0; overflow: hidden; }
  .detail-panel { display: none; height: 100%; min-height: 0; overflow: hidden; }
  .detail-panel.active { display: flex; flex-direction: column; }
  .panel-heading {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 44px;
    padding: 8px 13px;
    border-bottom: 1px solid var(--line-soft);
  }
  .panel-heading h3 { margin: 0; font-size: 11px; }
  .panel-heading span { color: var(--muted); font-size: 9px; }
  .retention-warning { flex: 0 0 auto; padding: 7px 12px; border-bottom: 1px solid rgb(237 180 94 / 30%); background: rgb(237 180 94 / 8%); color: var(--amber); font-size: 10px; }

  .conversation-scroll { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 12px; }
  .conversation { display: grid; gap: 8px; max-width: 920px; margin: 0 auto; }
  .turn {
    position: relative;
    padding: 9px 10px 10px 13px;
    border: 1px solid var(--line-soft);
    border-radius: 7px;
    background: var(--pane-raised);
    overflow: hidden;
  }
  .turn::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--role-tone, var(--muted)); }
  .turn.system { --role-tone: var(--violet); }
  .turn.user { --role-tone: var(--blue); }
  .turn.assistant { --role-tone: var(--accent); }
  .turn.tool { --role-tone: var(--amber); }
  .turn.error { --role-tone: var(--red); }
  .turn-role { color: var(--role-tone, var(--muted)); font-size: 8px; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; }
  .turn-content { margin-top: 5px; color: var(--text-soft); font-size: 11px; white-space: pre-wrap; overflow-wrap: anywhere; }

  .wire-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    flex: 1 1 auto;
    min-height: 0;
    background: var(--line);
  }
  .payload-card { display: flex; min-width: 0; min-height: 0; flex-direction: column; background: #080c12; overflow: hidden; }
  .payload-head {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--line-soft);
    color: var(--muted);
    font-size: 8px;
    font-weight: 850;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .payload-content { flex: 1 1 auto; min-height: 0; margin: 0; padding: 11px; overflow: auto; color: #d7e0eb; font-size: 10px; line-height: 1.55; white-space: pre-wrap; overflow-wrap: anywhere; }

  .chunk-list { flex: 1 1 auto; min-height: 0; margin: 0; padding: 10px; overflow: auto; list-style: none; }
  .chunk { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 8px; padding: 8px 9px; border-bottom: 1px solid var(--line-soft); }
  .chunk-index { color: var(--muted); font-size: 9px; font-weight: 800; }
  .chunk-content { color: var(--text-soft); font-size: 10px; white-space: pre-wrap; overflow-wrap: anywhere; }

  .runtime-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 12px; overflow: auto; }
  .meta-card { min-width: 0; padding: 9px 10px; border: 1px solid var(--line-soft); border-radius: 7px; background: var(--pane-raised); }
  .meta-value { margin-top: 4px; color: var(--text-soft); font-size: 10px; overflow-wrap: anywhere; }
  .runtime-note { margin: 0 12px 12px; padding: 10px; border: 1px solid var(--line-soft); border-radius: 7px; background: var(--pane-raised); }
  .runtime-note h4 { margin: 0; font-size: 10px; }
  .runtime-note p { margin: 5px 0 0; color: var(--text-soft); font-size: 10px; }

  .diagnostics-sheet {
    position: absolute;
    z-index: 100;
    top: 42px;
    right: -74px;
    width: min(920px, calc(100vw - 24px));
    max-height: calc(100vh - 76px);
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #0b111a;
    box-shadow: 0 24px 80px rgb(0 0 0 / 60%);
  }
  .diagnostics-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 14px; border-bottom: 1px solid var(--line); }
  .retention-note { color: var(--muted); font-size: 9px; }
  .diagnostics-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding: 10px; }
  .diagnostic-card { min-width: 0; border: 1px solid var(--line-soft); border-radius: 8px; background: var(--pane); overflow: hidden; }
  .diagnostic-card h3 { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0; padding: 8px 9px; border-bottom: 1px solid var(--line-soft); font-size: 10px; }
  .diagnostic-card:last-child { grid-column: span 2; }
