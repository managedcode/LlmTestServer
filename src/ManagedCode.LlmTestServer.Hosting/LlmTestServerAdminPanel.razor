    private LlmTestServerInsightChart FixtureChart()
    {
        string[] colors = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6"];
        var kinds = _models.GroupBy(model => model.Kind.ToString()).OrderByDescending(group => group.Count()).ThenBy(group => group.Key, StringComparer.Ordinal).ToArray();
        return new("fixtures", "Model fixtures", "Loaded models by kind", LlmTestServerDashboardCharts.Tokens(_models.Count),
            _models.Count == 1 ? "model" : "models",
            kinds.Select((group, index) => new LlmTestServerDashboardSegment(group.Key, group.Key, group.Count(),
                index < colors.Length ? colors[index] : "#a8a29e")).ToArray());
    }

