    private string? InsightSelection(string? kind)
    {
        return kind switch
        {
            LlmTestServerDashboardInsights.ProviderFilter => NullIfEmpty(_providerFilter),
            LlmTestServerDashboardInsights.ModelFilter => NullIfEmpty(_modelFilter),
            LlmTestServerDashboardInsights.SearchFilter => NullIfEmpty(_search),
            LlmTestServerDashboardInsights.OutcomeFilter => _outcomeFilter switch
            {
                "success" => "success",
                "stream" => "stream",
                _ => null,
            },
            _ => null,
        };

        static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
    }


    private RenderFragment InsightCard(LlmTestServerInsightChart chart) => __builder =>
    {
        var v = LlmTestServerInsightCardView.Create(chart, $"insight-{chart.Key}", InsightSelection(chart.FilterKind));
        <section class="@($"viz-card insight-card insight-{v.Chart.Form.ToString().ToLowerInvariant()}")" data-testid="@v.TestId" aria-label="@v.Chart.Title">
          <header class="viz-card-header insight-card-header">
            <div>
              <h4>@v.Chart.Title</h4>
              <p>@v.Chart.Subtitle</p>
            </div>
            @if (v.Chart.Form != LlmTestServerInsightForm.Donut && v.Visible.Count > 0)
            {
              <span class="insight-headline"><strong>@v.Chart.CenterValue</strong> @v.Chart.CenterLabel</span>
            }
          </header>
        <div class="insight-body">

          @if (v.Visible.Count == 0)
          {
            <p class="viz-empty">Nothing recorded yet.</p>
          }
          else if (v.Chart.Form == LlmTestServerInsightForm.Donut)
          {
            <div class="donut-layout">
              <div class="donut">
                <svg viewBox="0 0 128 128" role="img" aria-label="@v.AriaSummary">
                  <circle class="donut-track" cx="64" cy="64" r="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.DonutRadius)"></circle>
                  @foreach (var arc in v.Arcs)
                  {
                    <circle class="@InsightArcCss(v, arc.Segment.Key)" cx="64" cy="64" r="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.DonutRadius)" stroke-dasharray="@arc.DashArray" stroke-dashoffset="@arc.DashOffset" style="stroke: @arc.Segment.Color" data-tip="@ArcTip(arc)" data-tip-color="@arc.Segment.Color"></circle>
                  }
                </svg>
                <div class="donut-center"><strong>@v.Chart.CenterValue</strong><span>@v.Chart.CenterLabel</span></div>
              </div>
              <ul class="viz-legend">
                @foreach (var segment in v.Visible)
                {
                  <li>@InsightLegendRow(v, segment)</li>
                }
              </ul>
            </div>
          }
          else if (v.Chart.Form == LlmTestServerInsightForm.Bars)
          {
            <ul class="capsules">
              @foreach (var segment in v.Visible)
              {
                <li>
                  <button type="button" class="@InsightCapsuleCss(v, segment.Key)" disabled="@(!InsightCanSelect(v, segment))" aria-pressed="@InsightPressed(v, segment.Key)" data-tip="@SegmentTip(segment, v.Total)" data-tip-color="@segment.Color" @onclick="() => InsightSelect(v, segment)">
                    <span class="capsule-track"><span class="capsule-fill" style="width: @InsightWidth(segment.Tokens, v.Max); --tone: @segment.Color"></span><span class="capsule-label">@segment.Label</span></span>
                    <span class="capsule-value" data-testid="@($"{v.TestId}-value")" data-key="@segment.Key" data-value="@segment.Tokens">@LlmTestServerDashboardCharts.Tokens(segment.Tokens)</span>
                  </button>
                </li>
              }
            </ul>
          }
          else if (v.Chart.Form == LlmTestServerInsightForm.Columns)
          {
            <div class="columns" role="img" aria-label="@v.AriaSummary">
              @foreach (var segment in v.Chart.Segments.Where(segment => segment.Key != "running" || segment.Tokens > 0))
              {
                <div class="column" data-tip="@SegmentTip(segment, v.Total)" data-tip-color="@segment.Color">
                  <span class="column-value" data-testid="@($"{v.TestId}-value")" data-key="@segment.Key" data-value="@segment.Tokens">@LlmTestServerDashboardCharts.Tokens(segment.Tokens)</span>
                  <span class="column-bar"><span style="height: @InsightWidth(segment.Tokens, v.Max); background: @segment.Color"></span></span>
                  <span class="column-label">@segment.Label</span>
                </div>
              }
            </div>
          }
          else
          {
            <div class="dot-matrix" role="img" aria-label="@v.AriaSummary">
              @foreach (var color in v.Dots)
              {
                <span style="background: @color"></span>
              }
            </div>
            <ul class="viz-legend viz-legend-inline">
              @foreach (var segment in v.Visible)
              {
                <li>@InsightLegendRow(v, segment)</li>
              }
            </ul>
          }
        </div>
        </section>
    };

    private RenderFragment InsightLegendRow(LlmTestServerInsightCardView v, LlmTestServerDashboardSegment segment) => __builder =>
    {
        var share = v.Total > 0 ? LlmTestServerDashboardCharts.Percent((double)segment.Tokens / v.Total) : string.Empty;
        if (InsightCanSelect(v, segment))
        {
            <button type="button" class="viz-legend-button" aria-pressed="@InsightPressed(v, segment.Key)" @onclick="() => InsightSelect(v, segment)">
              <i style="background: @segment.Color"></i><span>@segment.Label</span><strong><span data-testid="@($"{v.TestId}-value")" data-key="@segment.Key" data-value="@segment.Tokens">@LlmTestServerDashboardCharts.Tokens(segment.Tokens)</span></strong><em>@share</em>
            </button>
        }
        else
        {
            <i style="background: @segment.Color"></i><span>@segment.Label</span><strong><span data-testid="@($"{v.TestId}-value")" data-key="@segment.Key" data-value="@segment.Tokens">@LlmTestServerDashboardCharts.Tokens(segment.Tokens)</span></strong><em>@share</em>
        }
    };

    private static bool InsightCanSelect(LlmTestServerInsightCardView v, LlmTestServerDashboardSegment segment)
    {
        return v.Chart.FilterKind is not null && segment.Key != LlmTestServerDashboardInsights.OtherKey && segment.Key != "—";
    }

    private void InsightSelect(LlmTestServerInsightCardView v, LlmTestServerDashboardSegment segment)
    {
        if (InsightCanSelect(v, segment))
        {
            ApplyInsightFilter(v.Chart.FilterKind!, segment.Key);
        }
    }

    private static string InsightPressed(LlmTestServerInsightCardView v, string key)
    {
        return string.Equals(v.SelectedKey, key, StringComparison.Ordinal) ? "true" : "false";
    }

    private static string InsightArcCss(LlmTestServerInsightCardView v, string key)
    {
        return v.SelectedKey is null || string.Equals(v.SelectedKey, key, StringComparison.Ordinal) ? "donut-arc" : "donut-arc muted";
    }

    private static string InsightCapsuleCss(LlmTestServerInsightCardView v, string key)
    {
        return v.SelectedKey is null || string.Equals(v.SelectedKey, key, StringComparison.Ordinal) ? "capsule" : "capsule muted";
    }

    private static string InsightWidth(long value, long max)
    {
        return $"{LlmTestServerDashboardCharts.Number(Math.Max(value > 0 ? 2 : 0, value * 100d / max))}%";
    }

    private void ApplyInsightFilter(string kind, string key)
    {
        // Selecting the active segment again clears that filter.
        switch (kind)
        {
            case LlmTestServerDashboardInsights.ProviderFilter:
                _providerFilter = IsProviderFilter(key) ? string.Empty : key;
                break;
            case LlmTestServerDashboardInsights.ModelFilter:
                _modelFilter = string.Equals(_modelFilter, key, StringComparison.OrdinalIgnoreCase) ? string.Empty : key;
                break;
            case LlmTestServerDashboardInsights.SearchFilter:
                _search = string.Equals(_search, key, StringComparison.Ordinal) ? string.Empty : key;
                break;
            case LlmTestServerDashboardInsights.OutcomeFilter:
                var outcome = key switch
                {
                    "success" => "success",
                    "stream" => "stream",
                    "client-error" or "server-error" or "transport" => "error",
                    _ => string.Empty,
                };
                _outcomeFilter = IsOutcomeFilter(outcome) ? string.Empty : outcome;
                break;
        }
    }

