            LlmTestServerCompatibilityTags.Groq => "Groq",
            LlmTestServerCompatibilityTags.Mistral => "Mistral",
            LlmTestServerCompatibilityTags.Ollama => "Ollama",
            LlmTestServerCompatibilityTags.Cohere => "Cohere",
            LlmTestServerCompatibilityTags.Bedrock => "Amazon Bedrock",
            LlmTestServerCompatibilityTags.OpenRouter => "OpenRouter",
