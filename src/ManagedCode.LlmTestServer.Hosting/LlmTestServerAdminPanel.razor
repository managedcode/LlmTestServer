        };
    }

    private static string StatusCssFor(LlmTestServerProviderHttpTrace trace)
    {
        if (!trace.IsCompleted)
        {
            return "status-chip warning";
        }

        if (trace.TransportState != LlmTestServerProviderHttpTraceTransportState.Completed)
        {
            return "status-chip error";
        }

        return trace.StatusCode switch
        {
            null => "status-chip error",
            < 400 => "status-chip success",
            >= 400 => "status-chip error",
        };
    }

    private static string StatusText(LlmTestServerProviderHttpTrace trace)
    {
        if (!trace.IsCompleted)
        {
            return "Running";
        }

        if (trace.TransportState != LlmTestServerProviderHttpTraceTransportState.Completed)
        {
            return trace.TransportState.ToString();
        }

        return trace.StatusCode switch
        {
            null => "No status",
            200 => "200 OK",
            201 => "201 Created",
            202 => "202 Accepted",
            204 => "204 Empty",
            400 => "400 Invalid",
            401 => "401 Auth",
            404 => "404 Missing",
            405 => "405 Method",
            409 => "409 Conflict",
            429 => "429 Limited",
            >= 500 => $"{trace.StatusCode} Server",
            _ => trace.StatusCode.Value.ToString(CultureInfo.InvariantCulture),
        };
    }

    private static string InboxStatusText(LlmTestServerProviderHttpTrace trace)
    {
        if (!trace.IsCompleted)
        {
            return "Live";
        }

        return trace.StatusCode?.ToString(CultureInfo.InvariantCulture)
            ?? trace.TransportState.ToString();
    }

    private static string FormatDuration(double? milliseconds)
    {
        if (milliseconds is null)
        {
            return "running";
        }

        return milliseconds < 1
            ? "<1 ms"
            : $"{milliseconds.Value:N0} ms";
    }

    private static string FormatBytes(long? bytes)
    {
        if (bytes is null)
        {
            return "unknown";
        }

        if (bytes < 1024)
        {
            return string.Create(CultureInfo.InvariantCulture, $"{bytes.Value:N0} B");
        }

        return string.Create(CultureInfo.InvariantCulture, $"{bytes.Value / 1024d:N1} KiB");
    }

    private static string TurnCss(string role)
    {
        if (string.Equals(role, "system", StringComparison.OrdinalIgnoreCase))
        {
            return "turn system";
        }

        if (string.Equals(role, "user", StringComparison.OrdinalIgnoreCase))
        {
            return "turn user";
        }

        if (string.Equals(role, "assistant", StringComparison.OrdinalIgnoreCase))
        {
            return "turn assistant";
        }

        return string.Equals(role, "tool", StringComparison.OrdinalIgnoreCase)
            ? "turn tool"
            : "turn";
    }

    private static string RuntimeResponseTurnCss(LlmTestServerProviderHttpTrace trace)
    {
        return trace.RuntimeEventKind == LlmTestServerEventKind.ErrorReturned
            ? "turn error"
            : "turn assistant";
    }

    private static string RuntimeResponseRole(LlmTestServerProviderHttpTrace trace)
    {
        if (trace.IsSuccess is false || trace.RuntimeEventKind == LlmTestServerEventKind.ErrorReturned)
        {
            return "provider error";
        }

        if (trace.ResponseToolCalls.Count > 0)
        {
            return "assistant · tool call";
        }

        return string.IsNullOrWhiteSpace(trace.RuntimeResponse)
            ? "provider response"
            : "assistant";
    }

