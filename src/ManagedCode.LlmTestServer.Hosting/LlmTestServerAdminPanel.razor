@using ManagedCode.LlmTestServer.Diagnostics
@namespace ManagedCode.LlmTestServer.Hosting
@using System.Globalization
@using System.Runtime.CompilerServices
@using System.Text
@using System.Text.Encodings.Web
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using ManagedCode.LlmTestServer.Control
@using ManagedCode.LlmTestServer.Models
@using ManagedCode.LlmTestServer.Providers
@using ManagedCode.LlmTestServer.Runtime
@using ManagedCode.LlmTestServer.Scenarios
@using Microsoft.Extensions.Options
@using Microsoft.FluentUI.AspNetCore.Components
@implements IAsyncDisposable
@inject ILlmTestServerRuntime Runtime
@inject ILlmTestServerProviderHttpTraceStore TraceStore
@inject IOptions<LlmTestServerProviderHttpTraceOptions> TraceOptions
@inject NavigationManager Navigation

@{
  var visibleTraces = FilterTraces();
  var providerOptions = GetProviderOptions();
  var modelOptions = GetModelOptions();
}

<div class="@WorkspaceCss">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true"><svg viewBox="0 0 240 240" width="32" height="32" focusable="false"><rect width="240" height="240" rx="56" fill="#161616"/><g transform="rotate(-45 120 120)"><path d="M120 76H86a44 44 0 0 0 0 88h34z" fill="#f4efe6"/><path d="M120 76h34a44 44 0 0 1 0 88h-34z" fill="#a4f258"/></g></svg></div>
      <div class="brand-copy">
        <div class="eyebrow">Deterministic provider lab</div>
        <h1><span class="brand-full">LLM Test Server request dashboard</span><span class="brand-short">LLM Test Server</span></h1>
      </div>
    </div>

    <div class="command-bar" aria-label="Runtime controls">
      <div class="@StatusCss" role="status" aria-live="polite" aria-label="@_statusText">
        <span class="status-dot" aria-hidden="true"></span>
        <span>@_statusText</span>
      </div>
      <label class="auto-toggle" title="Refresh runtime state every 15 seconds">
        <input type="checkbox" aria-label="Live auto-refresh" checked="@_autoRefresh" @onchange="SetAutoRefreshAsync">
        <span>Live</span>
      </label>
      <button class="toolbar-button accent" type="button" aria-label="Refresh runtime state" @onclick="RefreshAsync"><span aria-hidden="true">↻</span><span>Refresh</span></button>

      <button class="toolbar-button runtime-dialog-trigger" type="button" aria-label="Runtime settings" disabled="@(!_interactive)" aria-haspopup="dialog" aria-controls="runtime-dialog" aria-expanded="@(_runtimeDialogHidden ? "false" : "true")" @ref="_runtimeDialogTrigger" @onclick="OpenRuntimeDialogAsync"><span>Runtime</span><span aria-hidden="true">•••</span></button>
    </div>
  </header>

  <FluentDialog Id="runtime-dialog" Class="runtime-fluent-dialog" @ref="_runtimeDialog" @ondialogtoggle="RuntimeDialogToggled" Modal="true" role="dialog" aria-label="Runtime state">
        <div class="diagnostics-sheet">
          <header class="diagnostics-header">
            <div>
              <div class="eyebrow">Runtime setup & diagnostics</div>
              <h2 id="runtime-dialog-title">Runtime state</h2>
            </div>
            <div class="dialog-header-actions">
              <span class="retention-note">@FormatBytes(TraceStore.RetainedByteCount) retained</span>
              <button class="dialog-close" type="button" aria-label="Close runtime settings" @onclick="CloseRuntimeDialogAsync">×</button>
            </div>
          </header>
          <div class="runtime-settings">
            <label class="settings-token">
              <span>Bearer token</span>
              <input type="password" placeholder="Optional runtime token" autocomplete="off" spellcheck="false" @bind="_bearerToken" @bind:event="oninput">
            </label>
            <button class="toolbar-button danger" type="button" disabled="@_resetting" @onclick="ResetAsync">@(_resetting ? "Resetting…" : "Reset runtime")</button>
          </div>
          <div class="diagnostics-charts" data-testid="runtime-charts">
            @InsightCard(AssertionChart())
            @InsightCard(FixtureChart())
            <section class="viz-card insight-card event-card" data-testid="insight-runtime-events" aria-labelledby="runtime-events-chart-title">
              <header class="viz-card-header insight-card-header"><div><h4 id="runtime-events-chart-title">Event timeline</h4><p>Oldest to newest, colored by result</p></div></header>
              <div class="insight-body">
                @if (_events.Count == 0)
                {
                  <p class="viz-empty">No runtime events yet.</p>
                }
                else
                {
                  <div class="event-strip">
                    @foreach (var runtimeEvent in _events.TakeLast(120))
                    {
                      <span class="@($"event-dot {EventTone(runtimeEvent.Kind)}")" data-tip="@($"{runtimeEvent.Kind}\n{runtimeEvent.ModelId} · {runtimeEvent.Timestamp.ToLocalTime():HH:mm:ss}")"></span>
                    }
                  </div>
                  <ul class="viz-legend viz-legend-inline">
                    <li><i class="event-dot success"></i><span>Matched</span></li>
                    <li><i class="event-dot warning"></i><span>Unmatched or exhausted</span></li>
                    <li><i class="event-dot error"></i><span>Errors</span></li>
                  </ul>
                }
              </div>
            </section>
          </div>
          <div class="diagnostics-grid">
            <section class="diagnostic-card">
              <h3><span>Fixtures / models</span><span class="count-pill">@_models.Count</span></h3>
              <div class="diagnostic-body">
                @if (_models.Count == 0)
                {
                  <div class="diagnostic-empty">No models loaded.</div>
                }
                else
                {
                  <ul class="diagnostic-list">
                    @foreach (var model in _models)
                    {
                      <li class="diagnostic-row"><span class="diagnostic-primary mono">@model.Id</span><span class="diagnostic-secondary">@model.Kind · @model.OwnedBy</span></li>
                    }
                  </ul>
                }
              </div>
            </section>

            <section class="diagnostic-card">
              <h3><span>Provider APIs</span><span class="count-pill">@_providerRoutes.Count</span></h3>
              <div class="diagnostic-body">
                <ul class="diagnostic-list">
                  @foreach (var route in _providerRoutes)
                  {
                    <li class="diagnostic-row"><span class="diagnostic-primary">@route.Name</span><span class="diagnostic-secondary mono">@route.Route</span></li>
                  }
                </ul>
              </div>
            </section>

            <section class="diagnostic-card">
              <h3><span>Runtime actions</span><span class="count-pill">4</span></h3>
              <div class="diagnostic-body">
                <ul class="diagnostic-list">
                  <li class="diagnostic-row"><span class="diagnostic-primary">Refresh state</span><span class="diagnostic-secondary mono">GET @LlmTestServerControlRoutes.Assertions</span></li>
                  <li class="diagnostic-row"><span class="diagnostic-primary">List fixtures</span><span class="diagnostic-secondary mono">GET @LlmTestServerControlRoutes.Models</span></li>
                  <li class="diagnostic-row"><span class="diagnostic-primary">Configure runtime</span><span class="diagnostic-secondary mono">POST @LlmTestServerControlRoutes.Configure</span></li>
                  <li class="diagnostic-row"><span class="diagnostic-primary">Reset runtime</span><span class="diagnostic-secondary mono">POST @LlmTestServerControlRoutes.Reset</span></li>
                </ul>
              </div>
            </section>

            <section class="diagnostic-card">
              <h3><span>Assertions</span><span class="count-pill">@_summary.TotalEvents</span></h3>
              <div class="diagnostic-body">
                <ul class="diagnostic-list">
                  <li class="diagnostic-row"><span class="diagnostic-primary">Matched</span><span class="diagnostic-secondary">@_summary.Matched</span></li>
                  <li class="diagnostic-row"><span class="diagnostic-primary">Unmatched</span><span class="diagnostic-secondary">@_summary.Unmatched</span></li>
                  <li class="diagnostic-row"><span class="diagnostic-primary">Model not found</span><span class="diagnostic-secondary">@_summary.ModelNotFound</span></li>
                  <li class="diagnostic-row"><span class="diagnostic-primary">Auth failed</span><span class="diagnostic-secondary">@_summary.AuthFailed</span></li>
                  <li class="diagnostic-row"><span class="diagnostic-primary">Scenario exhausted</span><span class="diagnostic-secondary">@_summary.ScenarioExhausted</span></li>
                  <li class="diagnostic-row"><span class="diagnostic-primary">Errors returned</span><span class="diagnostic-secondary">@_summary.ErrorsReturned</span></li>
                </ul>
              </div>
            </section>

            <section class="diagnostic-card">
              <h3><span>Runtime events</span><span class="count-pill">@_events.Count</span></h3>
              <div class="diagnostic-body">
                @if (_events.Count == 0)
                {
                  <div class="diagnostic-empty">No runtime events yet.</div>
                }
                else
                {
                  <ul class="diagnostic-list">
                    @foreach (var runtimeEvent in _events.AsEnumerable().Reverse())
                    {
                      <li class="diagnostic-row">
                        <span class="event-line"><span class="status-chip @EventTone(runtimeEvent.Kind)">@runtimeEvent.Kind</span><span class="diagnostic-primary">@runtimeEvent.Message</span></span>
                        <span class="diagnostic-secondary mono">@runtimeEvent.ModelId · @runtimeEvent.Timestamp.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
                      </li>
                    }
                  </ul>
                }
              </div>
            </section>
          </div>
        </div>
  </FluentDialog>

  <div class="@BannerCss" role="@BannerRole" aria-live="assertive">@_bannerText</div>

  <main class="mail-workspace">
    <nav class="nav-rail" aria-label="Request navigation">
      <div class="rail-scroll">
        <section class="rail-section rail-views">
          <button class="@(_insightsOpen ? "rail-item rail-view selected" : "rail-item rail-view")" type="button" data-testid="insights-rail" aria-pressed="@AriaBoolean(_insightsOpen)" @onclick="ToggleInsights">
            <span class="rail-glyph"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-dasharray="21 14"></circle><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-opacity=".3" stroke-width="2.4" stroke-dasharray="13 22" stroke-dashoffset="-22"></circle></svg></span>
            <span>Traffic insights</span>
            <strong></strong>
          </button>
        </section>

        <section class="rail-section" aria-labelledby="request-summary-title">
          <h2 class="rail-heading" id="request-summary-title">Request summary</h2>
          <button class="@RailFilterCss(string.Empty)" style="--share: @RailShare(_traces.Count)" data-tip="@RailTip("All requests", _traces.Count)" type="button" aria-pressed="@AriaBoolean(IsOutcomeFilter(string.Empty))" @onclick="() => SetOutcomeFilter(string.Empty)">
            <span class="rail-icon all" aria-hidden="true">≡</span>
            <span>All requests</span>
            <strong>@_traces.Count</strong>
          </button>
          <button class='@RailFilterCss("success")' style="--share: @RailShare(SuccessfulTraceCount); --tone: #3f8d55" data-tip="@RailTip("Successful", SuccessfulTraceCount)" data-tip-color="#3f8d55" type="button" aria-pressed='@AriaBoolean(IsOutcomeFilter("success"))' @onclick='() => SetOutcomeFilter("success")'>
            <span class="rail-icon success" aria-hidden="true">✓</span>
            <span>Successful</span>
            <strong>@SuccessfulTraceCount</strong>
          </button>
          <button class='@RailFilterCss("error")' style="--share: @RailShare(FailedTraceCount); --tone: #c94f3d" data-tip="@RailTip("Errors", FailedTraceCount)" data-tip-color="#c94f3d" type="button" aria-pressed='@AriaBoolean(IsOutcomeFilter("error"))' @onclick='() => SetOutcomeFilter("error")'>
            <span class="rail-icon error" aria-hidden="true">!</span>
            <span>Errors</span>
            <strong>@FailedTraceCount</strong>
          </button>
          <button class='@RailFilterCss("stream")' style="--share: @RailShare(StreamingTraceCount); --tone: #2a78d6" data-tip="@RailTip("Streaming", StreamingTraceCount)" data-tip-color="#2a78d6" type="button" aria-pressed='@AriaBoolean(IsOutcomeFilter("stream"))' @onclick='() => SetOutcomeFilter("stream")'>
            <span class="rail-icon stream" aria-hidden="true">↝</span>
            <span>Streaming</span>
            <strong>@StreamingTraceCount</strong>
          </button>
          <button class='@RailFilterCss("cache")' style="--share: @RailShare(CacheTraceCount); --tone: #5aa02c" data-tip="@RailTip("Cache activity", CacheTraceCount)" data-tip-color="#5aa02c" type="button" aria-pressed='@AriaBoolean(IsOutcomeFilter("cache"))' @onclick='() => SetOutcomeFilter("cache")'>
            <span class="rail-icon cache" aria-hidden="true">◇</span>
            <span>Cache activity</span>
            <strong>@CacheTraceCount</strong>
          </button>
        </section>

        <section class="rail-section" aria-labelledby="providers-title">
          <div class="rail-section-title">
            <h2 class="rail-heading" id="providers-title">Providers</h2>
            @if (!string.IsNullOrWhiteSpace(_providerFilter))
            {
              <button class="rail-clear" type="button" @onclick="() => SetProviderFilter(string.Empty)">Clear</button>
            }
          </div>
          @foreach (var provider in providerOptions)
          {
            <button class="@ProviderFilterCss(provider)" style="--share: @RailShare(ProviderTraceCount(provider)); --tone: @ProviderColor(provider)" data-tip="@RailTip(ProviderName(provider), ProviderTraceCount(provider))" data-tip-color="@ProviderColor(provider)" type="button" aria-pressed="@AriaBoolean(IsProviderFilter(provider))" @onclick="() => SetProviderFilter(provider)">
              <span class="provider-dot" aria-hidden="true" style="background: @ProviderColor(provider)"></span>
              <span>@ProviderName(provider)</span>
              <strong>@ProviderTraceCount(provider)</strong>
            </button>
          }
          @if (providerOptions.Count == 0)
          {
            <div class="rail-empty">Providers appear after the first call.</div>
          }
        </section>

        <section class="rail-section">
          <label class="rail-select">
            <span class="rail-heading">Model</span>
            <select @bind="_modelFilter">
              <option value="">All models</option>
              @foreach (var model in modelOptions)
              {
                <option value="@model">@model</option>
              }
            </select>
          </label>
          @if (HasActiveFilters)
          {
            <button class="clear-filters" type="button" @onclick="ClearFilters">Clear all filters</button>
          }
        </section>
      </div>

      <footer class="rail-footer">
        <span>@_models.Count model fixtures</span>
        <span>@FormatBytes(TraceStore.RetainedByteCount) journal</span>
      </footer>
    </nav>

    <section class="request-inbox" aria-labelledby="request-table-title">
      <header class="inbox-header">
        <div>
          <h2 id="request-table-title">Provider requests</h2>
          <p>@visibleTraces.Count of @_traces.Count · newest first</p>
        </div>
        <button class="@(_insightsOpen ? "insights-trigger selected" : "insights-trigger")" type="button" data-testid="insights-open" aria-pressed="@AriaBoolean(_insightsOpen)" @onclick="ToggleInsights"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-dasharray="21 14"></circle><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-opacity=".3" stroke-width="2.4" stroke-dasharray="13 22" stroke-dashoffset="-22"></circle></svg><span>Insights</span></button>
      </header>

      <div class="inbox-tools" aria-label="Request filters">
        <label class="search-field">
          <span class="sr-only">Search requests</span>
          <input type="search" placeholder="Search requests…" @bind="_search" @bind:event="oninput">
        </label>
        <div class="compact-filters">
          <select aria-label="Provider" @bind="_providerFilter">
            <option value="">All providers</option>
            @foreach (var provider in providerOptions)
            {
              <option value="@provider">@ProviderName(provider)</option>
            }
          </select>
          <select aria-label="Model" @bind="_modelFilter">
            <option value="">All models</option>
            @foreach (var model in modelOptions)
            {
              <option value="@model">@model</option>
            }
          </select>
          <select aria-label="Outcome" @bind="_outcomeFilter">
            <option value="">All outcomes</option>
            <option value="success">Successful</option>
            <option value="error">Errors</option>
            <option value="stream">Streaming</option>
            <option value="cache">Cache activity</option>
          </select>
          <button class="toolbar-button" type="button" @onclick="ClearFilters">Clear</button>
        </div>
      </div>

      <div class="inbox-columns" aria-hidden="true"><span>Request</span><span>Result</span></div>

      @if (visibleTraces.Count == 0)
      {
        <div class="empty-state" data-testid="request-empty-state">
          <div>
            <strong>@(_traces.Count == 0 ? "No provider requests yet" : "No requests match these filters")</strong>
            <span>@(_traces.Count == 0 ? "Call a namespaced provider endpoint to start the inbox." : "Clear or change filters to see more calls.")</span>
          </div>
        </div>
      }
      else
      {
        <div class="inbox-list" role="list" aria-label="Captured provider requests">
          @foreach (var trace in visibleTraces)
          {
            var usage = UsageFor(trace);
            var messages = MessagesFor(trace);
            var messageCount = messages.Count;
            <button @key="trace.RequestId" class="@InboxItemCss(trace)" type="button" role="listitem" aria-current="@(IsSelected(trace) ? "true" : null)" aria-label="Inspect @ProviderName(trace.ProviderId) request to @ModelName(trace)" data-testid="request-row" data-request-id="@trace.RequestId" @onclick="() => SelectTrace(trace.RequestId)">
              <span class="inbox-item-top">
                <span class="provider-avatar" aria-hidden="true" style="--provider: @ProviderColor(trace.ProviderId)">@ProviderInitial(trace.ProviderId)</span>
                <span class="inbox-identity">
                  <strong class="inbox-model" title="@ModelName(trace)">@ModelName(trace)</strong>
                  <span class="inbox-provider">@ProviderName(trace.ProviderId)</span>
                </span>
                <time datetime="@trace.StartedAt.ToString("O", CultureInfo.InvariantCulture)">@trace.StartedAt.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</time>
              </span>
              <span class="inbox-preview" title="@RequestPreview(trace)">@RequestPreview(trace)</span>
              <span class="inbox-meta-row">
                <span class="@StatusCssFor(trace)">@InboxStatusText(trace)</span>
                <span class="inbox-stat">@FormatDuration(trace.DurationMilliseconds)</span>
                @if (usage is not null)
                {
                  <span class="inbox-tokens" data-tip="@TokenSparkTitle(usage)">
                    <span class="inbox-spark" aria-hidden="true">
                      @foreach (var part in TokenSpark(usage))
                      {
                        <span style="flex-grow: @part.Tokens; background: @part.Color"></span>
                      }
                    </span>
                    <span class="inbox-stat">@usage.TotalTokens.ToString("N0", CultureInfo.InvariantCulture) tok</span>
                  </span>
                }
                @if (trace.IsStreaming)
                {
                  <span class="inbox-stat inbox-flag">stream</span>
                }
                @if (messageCount > 1)
                {
                  <span class="inbox-stat inbox-flag">@messageCount turns</span>
                }
              </span>
            </button>
          }
        </div>
      }
    </section>

    <aside class="reading-pane" aria-label="Selected request details" data-testid="request-details">
      @if (_insightsOpen)
      {
        var insights = LlmTestServerDashboardInsights.Create(visibleTraces, _traces, ProviderName, ModelName, UsageFor, trace => MessagesFor(trace).Count);
        <section class="insights" data-testid="insights-panel" aria-labelledby="insights-title">
          <header class="insights-header">
            <button class="mobile-back" type="button" @onclick="CloseInsights">← Requests</button>
            <div>
              <h2 id="insights-title">Traffic insights</h2>
              <p>@(HasActiveFilters ? $"{insights.RequestCount} of {_traces.Count} retained requests · filters applied" : $"All {insights.RequestCount} retained requests")</p>
            </div>
            <div class="insights-actions">
              @if (HasActiveFilters)
              {
                <button class="toolbar-button" type="button" @onclick="ClearFilters">Clear filters</button>
              }
              <button class="toolbar-button" type="button" @onclick="CloseInsights">Done</button>
            </div>
          </header>
          @if (insights.RequestCount == 0)
          {
            <div class="reading-empty">
              <strong>@(_traces.Count == 0 ? "No provider requests yet" : "No requests match these filters")</strong>
              <span>Charts appear after the first provider call.</span>
            </div>
          }
          else
          {
            <div class="insights-scroll">
              <div class="insights-grid">
                <section class="viz-card insight-recent" data-testid="insight-recent" aria-labelledby="insight-recent-title">
                  <header class="viz-card-header insight-card-header">
                    <div><h4 id="insight-recent-title">Recent requests</h4><p>Oldest to newest · height is tokens, color is outcome</p></div>
                  </header>
                  <div class="insight-body">
                    @{ var recentMax = Math.Max(1L, insights.Recent.Max(item => item.Tokens)); }
                    <div class="recent-columns" style="--count: @insights.Recent.Count">
                      @foreach (var item in insights.Recent)
                      {
                        <button type="button" class="recent-column" data-tip="@item.Title" data-tip-color="@item.Color" aria-label="@item.Title" @onclick="() => SelectTrace(item.RequestId)"><span style="height: @RecentHeight(item.Tokens, recentMax); background: @item.Color"></span></button>
                      }
                    </div>
                    <ul class="viz-legend viz-legend-inline">
                      @foreach (var outcome in insights.Recent.GroupBy(item => (item.Outcome, item.Color)))
                      {
                        <li><i style="background: @outcome.Key.Color"></i><span>@outcome.Key.Outcome</span></li>
                      }
                    </ul>
                  </div>
                </section>
                @foreach (var chart in insights.Charts)
                {
                  @InsightCard(chart)
                }
              </div>
            </div>
          }
        </section>
      }
      else if (SelectedTrace is not { } selected)
      {
        <div class="reading-empty">
          <div class="reading-empty-icon" aria-hidden="true">↳</div>
          <strong>Select a request</strong>
          <span>Conversation, wire payloads, Total tokens, Cache read and Cache write open here.</span>
        </div>
      }
      else
      {
        var selectedUsage = UsageFor(selected);
        var selectedMessages = MessagesFor(selected);
        var selectedChunks = ChunksFor(selected);
        var selectedEvent = RuntimeEventFor(selected);
        var hasConversation = selected.ConversationIdWasProvided && !string.IsNullOrWhiteSpace(selected.ConversationId);
        var conversationScope = _analyticsConversation && hasConversation;
        var analytics = LlmTestServerDashboardAnalytics.Create(_evidenceSnapshot, selected, conversationScope);
        var usageIncomplete = analytics.UsageRequestCount < analytics.RequestCount || analytics.PendingCount > 0
            || conversationScope && _evidenceSnapshot.EvictedCount > 0;
        var sankey = LlmTestServerDashboardCharts.Sankey(analytics.FlowSources, analytics.FlowTargets);
        var mixArcs = LlmTestServerDashboardCharts.Donut(analytics.InputMix);
        var cacheArcs = LlmTestServerDashboardCharts.Donut(analytics.CacheMix);

        <header class="reading-header">
          <button class="mobile-back" type="button" @onclick="BackToRequests">← Requests</button>
          <span class="provider-avatar reading-avatar" aria-hidden="true" style="--provider: @ProviderColor(selected.ProviderId)">@ProviderInitial(selected.ProviderId)</span>
          <div class="reading-title">
            <h2>@ModelName(selected)</h2>
            <div class="reading-route"><span>@ProviderName(selected.ProviderId)</span><span class="mono">@selected.Method @selected.Path</span>@if (selected.IsStreaming) { <span>stream</span> }</div>
          </div>
          <span class="@StatusCssFor(selected) reading-status">@StatusText(selected)</span>
          <div class="reading-id mono" data-testid="selected-request-id">@selected.RequestId</div>
        </header>

        <section class="facts-strip vitals" aria-labelledby="metadata-title">
          <h3 class="sr-only" id="metadata-title">Request metadata</h3>
          <div class="vital vital-tokens">
            <span class="vital-label" id="usage-title">Tokens & cache</span>
            @if (selectedUsage is null)
            {
              <span class="vital-empty">No usage reported</span>
            }
            else
            {
              <span class="vital-bar" data-tip="@TokenSparkTitle(selectedUsage)">
                @foreach (var part in TokenSpark(selectedUsage))
                {
                  <span style="flex-grow: @part.Tokens; background: @part.Color"></span>
                }
              </span>
              <span class="vital-caption"><strong>@selectedUsage.TotalTokens.ToString("N0", CultureInfo.InvariantCulture)</strong> Total tokens</span>
            }
          </div>
          <div class="vital vital-cache">
            @{ var cacheShare = selectedUsage is { InputTokens: > 0 } ? (double)selectedUsage.CachedInputTokens / selectedUsage.InputTokens : 0; }
            <svg class="vital-ring" viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="14" class="vital-ring-track"></circle><circle cx="18" cy="18" r="14" class="vital-ring-value" stroke-dasharray="@LlmTestServerDashboardCharts.Number(cacheShare * 87.96) 87.96"></circle></svg>
            <span class="vital-text"><strong>@(selectedUsage is null ? "—" : LlmTestServerDashboardCharts.Percent(cacheShare) + " cached")</strong><span title="Cache read / Cache write">@(selectedUsage is null ? "—" : $"{selectedUsage.CachedInputTokens.ToString("N0", CultureInfo.InvariantCulture)} read · {selectedUsage.CacheCreationInputTokens.ToString("N0", CultureInfo.InvariantCulture)} written")</span></span>
          </div>
          <div class="vital vital-meta">
            <span class="vital-text"><strong>@FormatDuration(selected.DurationMilliseconds)</strong><span>@Empty(selected.ScenarioId) · @selected.StartedAt.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span></span>
          </div>
        </section>

        <nav class="detail-tabs" role="tablist" aria-label="Request detail views">
          <button id="overview-tab" class="@DetailTabCss(_overviewTab)" type="button" role="tab" aria-controls="overview-panel" aria-selected="@AriaBoolean(IsDetailTab(_overviewTab))" @onclick="() => SetDetailTab(_overviewTab)">Overview</button>
          <button id="conversation-tab" class="@DetailTabCss(_conversationTab)" type="button" role="tab" aria-controls="conversation-panel" aria-selected="@AriaBoolean(IsDetailTab(_conversationTab))" @onclick="() => SetDetailTab(_conversationTab)">Conversation <span>@selectedMessages.Count</span></button>
          <button id="wire-tab" class="@DetailTabCss(_wireTab)" type="button" role="tab" aria-controls="wire-panel" aria-selected="@AriaBoolean(IsDetailTab(_wireTab))" @onclick="() => SetDetailTab(_wireTab)">Wire</button>
          @if (selectedChunks.Count > 0)
          {
            <button id="stream-tab" class="@DetailTabCss(_streamTab)" type="button" role="tab" aria-controls="stream-panel" aria-selected="@AriaBoolean(IsDetailTab(_streamTab))" @onclick="() => SetDetailTab(_streamTab)">Stream <span>@selectedChunks.Count</span></button>
          }
          <button id="analytics-tab" data-testid="analytics-tab" class="@DetailTabCss(_analyticsTab)" type="button" role="tab" aria-controls="analytics-panel" aria-selected="@AriaBoolean(IsDetailTab(_analyticsTab))" @onclick="() => SetDetailTab(_analyticsTab)">Tokens</button>
          <button id="runtime-tab" class="@DetailTabCss(_runtimeTab)" type="button" role="tab" aria-controls="runtime-panel" aria-selected="@AriaBoolean(IsDetailTab(_runtimeTab))" @onclick="() => SetDetailTab(_runtimeTab)">Runtime</button>
        </nav>

        <div class="detail-panels">
          <section id="overview-panel" class="@DetailPanelCss(_overviewTab)" role="tabpanel" aria-labelledby="overview-tab" hidden="@(!IsDetailTab(_overviewTab))">
            <h3 class="sr-only" id="overview-title">Request and response overview</h3>
            <div class="overview-grid">
              <section class="overview-card request-overview">
                <header class="overview-card-header">
                  <div><span class="overview-kicker">Request</span><strong>@selectedMessages.Count message@(selectedMessages.Count == 1 ? string.Empty : "s")</strong></div>
                  <span class="mono">@selected.Method</span>
                </header>
                <div class="overview-card-body request-thread">
                  @ConversationStrip(selectedMessages, selectedUsage)
                  @foreach (var message in selectedMessages)
                  {
                    @if (ShouldCollapseTurn(message.Role, message.Content))
                    {
                      <details class="overview-message collapsed-message">
                        <summary><span class="message-role" style="--role: @RoleColor(message)">@RoleLabel(message)</span><span class="message-preview">@TurnPreview(message.Content)</span>@MessageMeter(message, selectedMessages)</summary>
                        @MessageBody(message, "message-content")
                      </details>
                    }
                    else
                    {
                      <article class="overview-message">
                        <span class="message-head"><span class="message-role" style="--role: @RoleColor(message)">@RoleLabel(message)</span>@MessageMeter(message, selectedMessages)</span>
                        @MessageBody(message, "message-content")
                      </article>
                    }
                  }
                </div>
              </section>

              <section class="overview-card response-overview">
                <header class="overview-card-header">
                  <div><span class="overview-kicker">Response</span><strong>@StatusText(selected)</strong></div>
                  <span>@FormatBytes(selected.ResponseByteCount)</span>
                </header>
                <div class="overview-card-body response-body">
                  <span class="message-role">@RuntimeResponseRole(selected)</span>
                  @if (selected.ResponseToolCalls.Count > 0)
                  {
                    <div class="tool-call-cards" data-testid="overview-tool-calls">
                      @foreach (var call in selected.ResponseToolCalls)
                      {
                        <article class="tool-call-card">
                          <header data-tip="@($"Tool call\n{call.Name} · {call.Id}")" data-tip-color="var(--mix-tool-calls)"><span class="tool-call-glyph" aria-hidden="true">ƒ</span><strong class="mono">@call.Name</strong><span class="mono">@call.Id</span></header>
                          <pre class="tool-call-args">@LlmTestServerJsonHighlighter.Highlight(call.ArgumentsJson, false)</pre>
                        </article>
                      }
                    </div>
                  }
                  @if (!string.IsNullOrWhiteSpace(selected.RuntimeResponse))
                  {
                    <div class="response-copy">@selected.RuntimeResponse</div>
                  }
                  else if (selected.ResponseToolCalls.Count > 0)
                  {
                    <details class="raw-json">
                      <summary>Raw provider response</summary>
                      <pre class="response-copy response-json" data-testid="overview-response-json">@LlmTestServerJsonHighlighter.Highlight(selected.ResponsePreview, selected.ResponsePreviewTruncated)</pre>
                    </details>
                  }
                  else
                  {
                    <pre class="response-copy response-json" data-testid="overview-response-json">@LlmTestServerJsonHighlighter.Highlight(selected.ResponsePreview, selected.ResponsePreviewTruncated)</pre>
                  }
                  @if (selectedUsage is { OutputTokens: > 0 })
                  {
                    <div class="output-meter" title="Visible response and reasoning tokens">
                      <span class="output-meter-bar"><span style="flex-grow: @Math.Max(0, selectedUsage.OutputTokens - selectedUsage.ReasoningTokens); background: var(--output-visible)"></span><span style="flex-grow: @selectedUsage.ReasoningTokens; background: var(--output-reasoning)"></span></span>
                      <span class="output-meter-legend"><span><i style="background: var(--output-visible)"></i>Response @LlmTestServerDashboardCharts.Tokens(Math.Max(0, selectedUsage.OutputTokens - selectedUsage.ReasoningTokens))</span><span><i style="background: var(--output-reasoning)"></i>Reasoning @LlmTestServerDashboardCharts.Tokens(selectedUsage.ReasoningTokens)</span></span>
                    </div>
                  }
                </div>
              </section>
            </div>
          </section>

          <section id="conversation-panel" class="@DetailPanelCss(_conversationTab)" role="tabpanel" aria-labelledby="conversation-tab" hidden="@(!IsDetailTab(_conversationTab))">
            <div class="panel-heading">
              <div><h3 id="conversation-title">Conversation</h3><span>@selectedMessages.Count input turn@(selectedMessages.Count == 1 ? string.Empty : "s")</span></div>
            </div>
            @if (selected.RuntimePayloadTruncated || selected.RetentionTruncated || selectedEvent?.PayloadTruncated is true)
            {
              <div class="retention-warning">This exceptionally large payload was shortened by the bounded in-memory journal.</div>
            }
            <div class="conversation-scroll">
              <div class="conversation" data-testid="conversation">
                @if (!string.IsNullOrWhiteSpace(selected.RuntimeResponse))
                {
                  <article class="@RuntimeResponseTurnCss(selected)" data-response-card="true" data-testid="conversation-turn">
                    <header class="response-card-header">
                      <div><div class="turn-role">@RuntimeResponseRole(selected)</div><span>Provider response</span></div>
                      <span class="@StatusCssFor(selected)">@StatusText(selected)</span>
                    </header>
                    <div class="turn-content">@selected.RuntimeResponse</div>
                  </article>
                }

                <div class="thread-heading"><strong>Request context</strong><span>@selectedMessages.Count input turn@(selectedMessages.Count == 1 ? string.Empty : "s") · chronological</span></div>
                @ConversationStrip(selectedMessages, selectedUsage)
                @foreach (var message in selectedMessages)
                {
                  @if (ShouldCollapseTurn(message.Role, message.Content))
                  {
                    <details class="@TurnCss(message.Role) turn-disclosure" data-testid="conversation-turn" data-collapsed-by-default="true">
                      <summary><span class="turn-role" style="--role: @RoleColor(message)">@RoleLabel(message)</span><span class="turn-preview">@TurnPreview(message.Content)</span>@MessageMeter(message, selectedMessages)</summary>
                      @MessageBody(message, "turn-content")
                    </details>
                  }
                  else
                  {
                    <article class="@TurnCss(message.Role)" data-testid="conversation-turn">
                      <div class="message-head"><span class="turn-role" style="--role: @RoleColor(message)">@RoleLabel(message)</span>@MessageMeter(message, selectedMessages)</div>
                      @MessageBody(message, "turn-content")
                    </article>
                  }
                }
              </div>
            </div>
          </section>

          <section id="wire-panel" class="@DetailPanelCss(_wireTab)" role="tabpanel" aria-labelledby="wire-tab" hidden="@(!IsDetailTab(_wireTab))">
            <div class="panel-heading">
              <div><h3 id="payload-title">Wire payloads</h3><span>Sanitized · @PreviewLimitLabel</span></div>
            </div>
            <div class="wire-grid">
              <article class="payload-card">
                <div class="payload-head"><span>Request</span>@SizeMeter(selected.RequestByteCount ?? 0, Math.Max(selected.RequestByteCount ?? 0, selected.ResponseByteCount))<span>@Empty(selected.RequestContentType)</span></div>
                <pre class="payload-content" data-testid="request-payload">@LlmTestServerJsonHighlighter.Highlight(selected.RequestPreview, selected.RequestPreviewTruncated)</pre>
              </article>
              <article class="payload-card">
                <div class="payload-head"><span>Response</span>@SizeMeter(selected.ResponseByteCount, Math.Max(selected.RequestByteCount ?? 0, selected.ResponseByteCount))<span>@Empty(selected.ResponseContentType)</span></div>
                <pre class="payload-content" data-testid="response-payload">@LlmTestServerJsonHighlighter.Highlight(selected.ResponsePreview, selected.ResponsePreviewTruncated)</pre>
              </article>
            </div>
          </section>

          @if (selectedChunks.Count > 0)
          {
            <section id="stream-panel" class="@DetailPanelCss(_streamTab)" role="tabpanel" aria-labelledby="stream-tab" hidden="@(!IsDetailTab(_streamTab))">
              <div class="panel-heading">
                <div><h3 id="chunks-title">Stream chunks</h3><span>@selectedChunks.Count ordered chunk@(selectedChunks.Count == 1 ? string.Empty : "s")</span></div>
              </div>
              @{ var chunkTokens = selectedChunks.Select(chunk => LlmTestServerTokenCounter.CountTextTokens(chunk)).ToArray(); var chunkMax = Math.Max(1, chunkTokens.Max()); }
              <div class="chunk-chart" data-testid="stream-chunk-chart" aria-label="Tokens per streamed chunk">
                @for (var index = 0; index < selectedChunks.Count; index++)
                {
                  <span data-tip="@($"Chunk #{index + 1}\n{chunkTokens[index]} tokens · {selectedChunks[index].Length} chars")" data-tip-color="var(--mix-assistant)"><span style="height: @RecentHeight(chunkTokens[index], chunkMax)"></span></span>
                }
              </div>
              <ol class="chunk-list">
                @for (var index = 0; index < selectedChunks.Count; index++)
                {
                  <li class="chunk"><span class="chunk-index">#@(index + 1)</span><span class="chunk-content">@selectedChunks[index]</span></li>
                }
              </ol>
            </section>
          }

          <section id="analytics-panel" data-testid="analytics-panel" class="@DetailPanelCss(_analyticsTab) analytics-panel" role="tabpanel" aria-labelledby="analytics-tab" hidden="@(!IsDetailTab(_analyticsTab))">
            <div class="analytics-scroll">
              <header class="analytics-heading">
                <div>
                  <h3>Token analytics</h3>
                  <p data-testid="analytics-scope-label">@(hasConversation ? $"Conversation “{selected.ConversationId}” · same session and provider; models may differ" : "This request · no explicit conversation label")</p>
                </div>
                <div class="analytics-scope" role="group" aria-label="Analytics scope">
                  <button type="button" data-testid="analytics-scope-request" aria-pressed="@AriaBoolean(!conversationScope)" @onclick="() => _analyticsConversation = false">Request</button>
                  <button type="button" data-testid="analytics-scope-conversation" aria-pressed="@AriaBoolean(conversationScope)" disabled="@(!hasConversation)" title="@(hasConversation ? null : "Send X-Llm-Test-Server-Conversation to group requests")" @onclick="() => _analyticsConversation = true">Conversation</button>
                </div>
              </header>

              <p class="analytics-scope-line" data-testid="analytics-retention" data-incomplete="@AriaBoolean(usageIncomplete)">
                <span><span data-testid="analytics-requests" data-value="@analytics.RequestCount">@analytics.RequestCount</span> request@(analytics.RequestCount == 1 ? string.Empty : "s") · <span data-testid="analytics-usage-requests" data-value="@analytics.UsageRequestCount">@analytics.UsageRequestCount</span> with usage · journal @_evidenceSnapshot.Requests.Count of @_evidenceSnapshot.TotalObserved retained</span>
                @if (conversationScope && _evidenceSnapshot.EvictedCount > 0) { <span class="analytics-flag">@_evidenceSnapshot.EvictedCount earlier request(s) evicted · totals may be partial</span> }
                @if (analytics.PendingCount > 0) { <span class="analytics-flag">@analytics.PendingCount pending · totals may change</span> }
                @if (analytics.UsageRequestCount < analytics.RequestCount) { <span class="analytics-flag">no usage reported for @(analytics.RequestCount - analytics.UsageRequestCount) request(s)</span> }
              </p>
              @if (analytics.PayloadTruncated || _evidenceSnapshot.RetentionTruncated)
              {
                <p class="analytics-flag-note" data-testid="analytics-payload-retention">Payloads were shortened by the retention budget. Token counts are complete; tool observations may be partial.</p>
              }

              <div class="token-hero">
                <div class="token-hero-total">
                  <span class="token-hero-value" data-testid="analytics-total" data-value="@AnalyticsValue(analytics.TotalTokens, analytics)">@AnalyticsNumber(analytics.TotalTokens, analytics)</span>
                  <span class="token-hero-caption">@(conversationScope ? "tokens across the conversation" : "tokens in this request")</span>
                </div>
                <dl class="token-hero-stats">
                  <div><dt>Input</dt><dd><span data-testid="analytics-input" data-value="@AnalyticsValue(analytics.InputTokens, analytics)">@AnalyticsNumber(analytics.InputTokens, analytics)</span><small>@(analytics.ItemizedRequestCount > 0 ? $"{AnalyticsShare(analytics.SystemTokens + analytics.ToolDefinitionTokens, analytics.InputTokens)} system and tool schemas" : "per-role split unavailable")</small></dd></div>
                  <div><dt>Output</dt><dd><span data-testid="analytics-output" data-value="@AnalyticsValue(analytics.OutputTokens, analytics)">@AnalyticsNumber(analytics.OutputTokens, analytics)</span><small>incl. <span data-testid="analytics-reasoning" data-value="@AnalyticsValue(analytics.ReasoningTokens, analytics)">@AnalyticsNumber(analytics.ReasoningTokens, analytics)</span> reasoning</small></dd></div>
                  <div><dt>Cached input</dt><dd><span data-testid="analytics-cache-share" data-value="@AnalyticsRatioValue(analytics.CacheShare)">@AnalyticsPercent(analytics.CacheShare)</span><small>@AnalyticsNumber(analytics.CacheReadTokens, analytics) read from cache</small></dd></div>
                </dl>
              </div>

              <section class="viz-card sankey-card" aria-labelledby="analytics-flow-title">
                <header class="viz-card-header">
                  <h4 id="analytics-flow-title">Where the tokens go</h4>
                  <p>Prompt parts and generated output, by how they are billed</p>
                </header>
                @if (sankey is null)
                {
                  <div class="viz-empty" data-testid="analytics-flow-empty">No token usage was reported for this scope, so there is nothing to break down.</div>
                }
                else
                {
                  <div class="sankey" data-testid="analytics-flow" style="height: @(LlmTestServerDashboardCharts.Number(sankey.Height))px">
                    <svg class="sankey-svg" viewBox="0 0 @LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.SankeyWidth) @LlmTestServerDashboardCharts.Number(sankey.Height)" preserveAspectRatio="none" role="img" aria-label="Token flow: @string.Join(", ", sankey.Sources.Select(node => $"{node.Segment.Label} {LlmTestServerDashboardCharts.Tokens(node.Segment.Tokens)}")) into @LlmTestServerDashboardCharts.Tokens(sankey.Total) tokens; @string.Join(", ", sankey.Targets.Select(node => $"{node.Segment.Label} {LlmTestServerDashboardCharts.Tokens(node.Segment.Tokens)}"))">
                      @foreach (var band in sankey.Bands)
                      {
                        <path class="sankey-band" d="@band.Path" style="fill: @band.Color" data-tip="@band.Title" data-tip-color="@band.Color"></path>
                      }
                      @foreach (var node in sankey.Sources)
                      {
                        <rect class="sankey-node" x="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.SourceX)" y="@LlmTestServerDashboardCharts.Number(node.Y)" width="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.NodeWidth)" height="@LlmTestServerDashboardCharts.Number(node.Height)" style="fill: @node.Segment.Color" data-tip="@NodeTip(node)" data-tip-color="@node.Segment.Color"></rect>
                      }
                      <rect class="sankey-center" x="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.CenterX)" y="@LlmTestServerDashboardCharts.Number(sankey.CenterY)" width="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.NodeWidth)" height="@LlmTestServerDashboardCharts.Number(sankey.CenterHeight)" data-tip="@($"Request total\n{LlmTestServerDashboardCharts.Tokens(sankey.Total)} tokens")"></rect>
                      @foreach (var node in sankey.Targets)
                      {
                        <rect class="sankey-node" x="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.TargetX)" y="@LlmTestServerDashboardCharts.Number(node.Y)" width="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.NodeWidth)" height="@LlmTestServerDashboardCharts.Number(node.Height)" style="fill: @node.Segment.Color" data-tip="@NodeTip(node)" data-tip-color="@node.Segment.Color"></rect>
                      }
                    </svg>
                    <div class="sankey-total" style="top: @(LlmTestServerDashboardCharts.Number(sankey.CenterY))px">@LlmTestServerDashboardCharts.Tokens(sankey.Total) <span>tokens</span></div>
                    @foreach (var node in sankey.Sources)
                    {
                      <div class="sankey-label sankey-source" data-testid="analytics-flow-source" data-key="@node.Segment.Key" style="top: @(LlmTestServerDashboardCharts.Number(node.Center))px">
                        <span class="sankey-name"><i style="background: @node.Segment.Color"></i>@node.Segment.Label</span>
                        <span class="sankey-value"><strong>@LlmTestServerDashboardCharts.Tokens(node.Segment.Tokens)</strong> @LlmTestServerDashboardCharts.Percent(node.Share)</span>
                      </div>
                    }
                    @foreach (var node in sankey.Targets)
                    {
                      <div class="sankey-label sankey-target" data-testid="analytics-flow-target" data-key="@node.Segment.Key" style="top: @(LlmTestServerDashboardCharts.Number(node.Center))px">
                        <span class="sankey-name"><i style="background: @node.Segment.Color"></i>@node.Segment.Label</span>
                        <span class="sankey-value"><strong>@LlmTestServerDashboardCharts.Tokens(node.Segment.Tokens)</strong> @LlmTestServerDashboardCharts.Percent(node.Share)</span>
                      </div>
                    }
                  </div>
                  <div class="sankey-legend" aria-hidden="true">
                    @foreach (var column in new[] { sankey.Sources, sankey.Targets })
                    {
                      <ul class="viz-legend">
                        @foreach (var node in column)
                        {
                          <li><i style="background: @node.Segment.Color"></i><span>@node.Segment.Label</span><strong>@LlmTestServerDashboardCharts.Tokens(node.Segment.Tokens)</strong><em>@LlmTestServerDashboardCharts.Percent(node.Share)</em></li>
                        }
                      </ul>
                    }
                  </div>
                }
              </section>

              <div class="viz-pair">
                <section class="viz-card donut-card" aria-labelledby="analytics-mix-title">
                  <header class="viz-card-header">
                    <h4 id="analytics-mix-title">Context mix</h4>
                    <p>What the input is made of</p>
                  </header>
                  <div class="donut-layout">
                    <div class="donut">
                      <svg viewBox="0 0 128 128" role="img" aria-label="Input composition">
                        <circle class="donut-track" cx="64" cy="64" r="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.DonutRadius)"></circle>
                        @foreach (var arc in mixArcs)
                        {
                          <circle class="donut-arc" cx="64" cy="64" r="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.DonutRadius)" stroke-dasharray="@arc.DashArray" stroke-dashoffset="@arc.DashOffset" style="stroke: @arc.Segment.Color" data-tip="@ArcTip(arc)" data-tip-color="@arc.Segment.Color"></circle>
                        }
                      </svg>
                      <div class="donut-center"><strong>@AnalyticsNumber(analytics.InputTokens, analytics)</strong><span>input</span></div>
                    </div>
                    @if (mixArcs.Count == 0)
                    {
                      <p class="viz-empty">No input tokens reported.</p>
                    }
                    else
                    {
                      <ul class="viz-legend">
                        @foreach (var arc in mixArcs)
                        {
                          <li><i style="background: @arc.Segment.Color"></i><span>@arc.Segment.Label</span><strong><span data-testid="analytics-mix-@arc.Segment.Key" data-value="@arc.Segment.Tokens">@LlmTestServerDashboardCharts.Tokens(arc.Segment.Tokens)</span></strong><em>@LlmTestServerDashboardCharts.Percent(arc.Share)</em></li>
                        }
                      </ul>
                    }
                  </div>
                  @if (analytics.NotItemizedTokens > 0)
                  {
                    <p class="viz-footnote">Not itemized: input reported without per-role messages, such as embeddings or media prompts.</p>
                  }
                </section>

                <section class="viz-card donut-card" aria-labelledby="analytics-cache-title">
                  <header class="viz-card-header">
                    <h4 id="analytics-cache-title">Prompt cache</h4>
                    <p>How the input was served</p>
                  </header>
                  <div class="donut-layout">
                    <div class="donut">
                      <svg viewBox="0 0 128 128" role="img" aria-label="Prompt cache usage">
                        <circle class="donut-track" cx="64" cy="64" r="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.DonutRadius)"></circle>
                        @foreach (var arc in cacheArcs)
                        {
                          <circle class="donut-arc" cx="64" cy="64" r="@LlmTestServerDashboardCharts.Number(LlmTestServerDashboardCharts.DonutRadius)" stroke-dasharray="@arc.DashArray" stroke-dashoffset="@arc.DashOffset" style="stroke: @arc.Segment.Color" data-tip="@ArcTip(arc)" data-tip-color="@arc.Segment.Color"></circle>
                        }
                      </svg>
                      <div class="donut-center"><strong>@AnalyticsPercent(analytics.CacheShare)</strong><span>cache read</span></div>
                    </div>
                    <ul class="viz-legend">
                      <li><i style="background: var(--cache-read)"></i><span>Cache read</span><strong><span data-testid="analytics-cache-read" data-value="@AnalyticsValue(analytics.CacheReadTokens, analytics)">@AnalyticsNumber(analytics.CacheReadTokens, analytics)</span></strong><em>@AnalyticsShare(analytics.CacheReadTokens, analytics.InputTokens)</em></li>
                      <li><i style="background: var(--cache-write)"></i><span>Cache write</span><strong><span data-testid="analytics-cache-write" data-value="@AnalyticsValue(analytics.CacheWriteTokens, analytics)">@AnalyticsNumber(analytics.CacheWriteTokens, analytics)</span></strong><em>@AnalyticsShare(analytics.CacheWriteTokens, analytics.InputTokens)</em></li>
                      <li><i style="background: var(--cache-none)"></i><span>Uncached</span><strong>@AnalyticsNumber(analytics.UncachedInputTokens, analytics)</strong><em>@AnalyticsShare(analytics.UncachedInputTokens, analytics.InputTokens)</em></li>
                    </ul>
                  </div>
                  <p class="viz-footnote">Cache reads in <span data-testid="analytics-cache-hits" data-value="@analytics.CacheHitCount">@analytics.CacheHitCount</span> of @analytics.UsageRequestCount request@(analytics.UsageRequestCount == 1 ? string.Empty : "s") with usage · <span data-testid="analytics-cache-hit-rate" data-value="@AnalyticsRatioValue(analytics.CacheHitRate)">@AnalyticsPercent(analytics.CacheHitRate)</span></p>
                </section>
                @InsightCard(new("output-mix", "Output", "Visible response and reasoning", AnalyticsNumber(analytics.OutputTokens, analytics), "output", analytics.OutputMix))
                @InsightCard(new("tool-mix", "Tool tokens", "Schemas, call arguments and results", LlmTestServerDashboardCharts.Tokens(analytics.ToolDefinitionTokens + analytics.ToolCallTokens + analytics.ToolResultTokens), "tool tokens", analytics.ToolMix))
              </div>

              @if (conversationScope && analytics.Requests.Count > 1)
              {
                var timelineMax = Math.Max(1L, analytics.Requests.Max(point => (long)(point.Usage?.TotalTokens ?? 0)));
                <section class="viz-card timeline-card" aria-labelledby="analytics-timeline-title">
                  <header class="viz-card-header">
                    <h4 id="analytics-timeline-title">Context growth</h4>
                    <p>Tokens per request, oldest first · repeated context counts on every request</p>
                  </header>
                  <div class="timeline" data-testid="analytics-timeline">
                    @for (var index = 0; index < analytics.Requests.Count; index++)
                    {
                      var point = analytics.Requests[index];
                      var pointUsage = point.Usage;
                      <button type="button" class="@(string.Equals(point.RequestId, selected.RequestId, StringComparison.Ordinal) ? "timeline-step current" : "timeline-step")" data-testid="analytics-timeline-step" data-tip="@TimelineTitle(index, point)" aria-label="@TimelineTitle(index, point)" @onclick="() => SelectAnalyticsRequest(point.RequestId)">
                        <span class="timeline-bar">
                          @if (pointUsage is null)
                          {
                            <span class="timeline-missing"></span>
                          }
                          else
                          {
                            <span class="timeline-stack" style="height: @(TimelineHeight(pointUsage.TotalTokens, timelineMax))">
                              <span style="flex-grow: @pointUsage.CachedInputTokens; background: var(--cache-read)"></span>
                              <span style="flex-grow: @pointUsage.CacheCreationInputTokens; background: var(--cache-write)"></span>
                              <span style="flex-grow: @Math.Max(0, pointUsage.InputTokens - pointUsage.CachedInputTokens - pointUsage.CacheCreationInputTokens); background: var(--cache-none)"></span>
                              <span style="flex-grow: @pointUsage.OutputTokens; background: var(--output-visible)"></span>
                            </span>
                          }
                        </span>
                        <span class="timeline-index">#@(index + 1)</span>
                      </button>
                    }
                  </div>
                  <ul class="viz-legend viz-legend-inline">
                    <li><i style="background: var(--cache-read)"></i><span>Cache read</span></li>
                    <li><i style="background: var(--cache-write)"></i><span>Cache write</span></li>
                    <li><i style="background: var(--cache-none)"></i><span>Uncached</span></li>
                    <li><i style="background: var(--output-visible)"></i><span>Output</span></li>
                  </ul>
                </section>
              }

              <section class="viz-card analytics-tools" aria-labelledby="analytics-tools-title">
                <header class="viz-card-header">
                  <h4 id="analytics-tools-title">Function tools</h4>
                  <p><span data-testid="analytics-tool-calls" data-value="@analytics.CallsReturned">@analytics.CallsReturned</span> calls returned · <span data-testid="analytics-tool-results" data-value="@analytics.ResultsObserved">@analytics.ResultsObserved</span> results in context · <span data-testid="analytics-tool-result-ids" data-value="@analytics.DistinctResultIds">@analytics.DistinctResultIds</span> distinct result IDs</p>
                </header>
                @if (analytics.Tools.Count == 0)
                {
                  <p class="viz-empty">No function calls or tool results in this scope.</p>
                }
                else
                {
                  var toolMax = Math.Max(1, analytics.Tools.Max(tool => Math.Max(tool.CallsReturned, tool.ResultsObserved)));
                  <ul class="tool-capsules" aria-label="Function tool observations by name">
                    @foreach (var tool in analytics.Tools)
                    {
                      <li data-testid="analytics-tool-row" data-tool-name="@tool.Name">
                        <span class="tool-capsule-name mono" data-testid="analytics-tool-name">@tool.Name</span>
                        <span class="tool-capsule-bars" aria-hidden="true">
                          <span class="tool-capsule-calls" style="width: @ToolMeterWidth(tool.CallsReturned, toolMax)"></span>
                          <span class="tool-capsule-results" style="width: @ToolMeterWidth(tool.ResultsObserved, toolMax)"></span>
                        </span>
                        <span class="tool-capsule-stats"><span><i class="swatch-calls"></i><span data-testid="analytics-tool-calls-returned" data-value="@tool.CallsReturned">@tool.CallsReturned</span> returned</span><span><i class="swatch-results"></i><span data-testid="analytics-tool-results-observed" data-value="@tool.ResultsObserved">@tool.ResultsObserved</span> in context</span><span><span data-testid="analytics-result-ids" data-value="@tool.ResultIds.Count">@tool.ResultIds.Count</span> result IDs</span></span>
                      </li>
                    }
                  </ul>
                  <details class="analytics-observed-ids"><summary>Observed tool-result call IDs</summary>@foreach (var tool in analytics.Tools.Where(tool => tool.ResultIds.Count > 0)) { <p><strong>@tool.Name</strong> <span class="mono">@string.Join(", ", tool.ResultIds)</span></p> }</details>
                }
              </section>

              <details class="analytics-notes">
                <summary>How these numbers are counted</summary>
                <ul>
                  <li>Input includes cache read and cache write; output includes reasoning. Total is input plus output, so subsets are never added twice.</li>
                  <li>The context mix uses the server tokenizer per message and per tool schema; the parts add up exactly to the reported input. Tool-call arguments inside assistant turns are split out from assistant text.</li>
                  <li>Conversation totals sum every retained request with the same label, session and provider, so repeated context counts again on each request. They are not a billing estimate.</li>
                  <li>Cache-read request rate uses requests that reported usage, not provider cache eligibility.</li>
                  <li>Returned calls and in-context results are observations of the retained journal, not proof that an external function ran. Replayed responses count as returned calls for each request.</li>
                </ul>
              </details>
            </div>
          </section>

          <section id="runtime-panel" class="@DetailPanelCss(_runtimeTab)" role="tabpanel" aria-labelledby="runtime-tab" hidden="@(!IsDetailTab(_runtimeTab))">
            <div class="panel-heading"><div><h3 id="runtime-title">Runtime detail</h3><span>Correlation and transport metadata</span></div></div>
            <div class="anatomy" data-testid="runtime-anatomy" aria-label="Request path">
              <div class="anatomy-node"><span>Request</span><strong>@FormatBytes(selected.RequestByteCount)</strong><em>@Empty(selected.RequestContentType)</em></div>
              <div class="anatomy-link"><span>@selected.Method</span></div>
              <div class="anatomy-node anatomy-server"><span>LLM Test Server</span><strong>@FormatDuration(selected.DurationMilliseconds)</strong><em>@Empty(selected.ScenarioId)</em></div>
              <div class="@(selected.IsSuccess is false ? "anatomy-link failed" : "anatomy-link")"><span>@InboxStatusText(selected)</span></div>
              <div class="anatomy-node"><span>Response</span><strong>@FormatBytes(selected.ResponseByteCount)</strong><em>@Empty(selected.ResponseContentType)</em></div>
            </div>
            <div class="runtime-grid">
              <div class="meta-card"><div class="meta-label">Operation</div><div class="meta-value mono">@Empty(selected.OperationId)</div></div>
              <div class="meta-card"><div class="meta-label">Transport</div><div class="meta-value">@selected.TransportState</div></div>
              <div class="meta-card"><div class="meta-label">Request content</div><div class="meta-value mono">@Empty(selected.RequestContentType)</div></div>
              <div class="meta-card"><div class="meta-label">Response content</div><div class="meta-value mono">@Empty(selected.ResponseContentType)</div></div>
              <div class="meta-card"><div class="meta-label">Error code</div><div class="meta-value mono">@Empty(selected.ErrorCode)</div></div>
              <div class="meta-card"><div class="meta-label">Retention</div><div class="meta-value">@FormatBytes(selected.RetainedByteCount)</div></div>
              <div class="meta-card"><div class="meta-label">Prompt cache</div><div class="meta-value">@(selectedEvent?.PromptCachePolicy.ToString() ?? "Not reported")</div></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(selected.RuntimeMessage))
            {
              <section class="runtime-note">
                <h4>Runtime note</h4>
                <p>@selected.RuntimeMessage</p>
              </section>
            }
          </section>
        </div>
      }
    </aside>
  </main>

  <footer class="sr-only">Served by MapLlmTestServer(); the request journal is bounded and never records authorization headers.</footer>
</div>
@code {
    private const string _overviewTab = "overview";
    private const string _conversationTab = "conversation";
    private const string _wireTab = "wire";
    private const string _streamTab = "stream";
    private const string _runtimeTab = "runtime";
    private const string _analyticsTab = "analytics";
    private const int _collapsedTurnThreshold = 420;
    private const int _turnPreviewLimit = 132;
    private static readonly TimeSpan _autoRefreshInterval = TimeSpan.FromSeconds(15);
    private static readonly IReadOnlyList<ProviderRoute> _providerRoutes =
    [
        new("OpenAI", LlmTestServerProviderRouteNamespaces.OpenAI),
        new("Azure OpenAI", LlmTestServerProviderRouteNamespaces.AzureOpenAI),
        new("Microsoft Foundry", LlmTestServerProviderRouteNamespaces.MicrosoftFoundry),
        new("Anthropic", LlmTestServerProviderRouteNamespaces.Anthropic),
        new("Gemini", LlmTestServerProviderRouteNamespaces.Gemini),
        new("Groq", LlmTestServerProviderRouteNamespaces.Groq),
        new("Mistral", LlmTestServerProviderRouteNamespaces.Mistral),
        new("Ollama", LlmTestServerProviderRouteNamespaces.Ollama),
        new("Cohere", LlmTestServerProviderRouteNamespaces.Cohere),
        new("Amazon Bedrock", LlmTestServerProviderRouteNamespaces.Bedrock),
        new("OpenRouter", LlmTestServerProviderRouteNamespaces.OpenRouter),
        new("DeepSeek", LlmTestServerProviderRouteNamespaces.DeepSeek),
        new("Perplexity", LlmTestServerProviderRouteNamespaces.Perplexity),
    ];

    private IReadOnlyList<LlmTestServerModel> _models = [];
    private IReadOnlyList<LlmTestServerProviderHttpTrace> _traces = [];
    private IReadOnlyList<LlmTestServerRuntimeEvent> _events = [];
    private IReadOnlyDictionary<string, LlmTestServerRuntimeEvent> _eventsByRequestId =
        new Dictionary<string, LlmTestServerRuntimeEvent>(StringComparer.Ordinal);
    private LlmTestServerAssertionSummary _summary = new();
    private LlmTestServerRequestSnapshot _evidenceSnapshot = new();
    private bool _analyticsConversation;
    private bool _insightsOpen;
    private IReadOnlyDictionary<string, string> _providerColors = new Dictionary<string, string>(StringComparer.Ordinal);
    private string _bearerToken = string.Empty;
    private string _search = string.Empty;
    private string _providerFilter = string.Empty;
    private string _modelFilter = string.Empty;
    private string _outcomeFilter = string.Empty;
    private string _activeDetailTab = _overviewTab;
    private string? _selectedRequestId;
    private bool _mobileDetailsOpen;
    private bool _autoRefresh = true;
    private bool _resetting;
    private bool _runtimeDialogHidden = true;
    private bool _interactive;
    private bool _restoreRuntimeTriggerFocus;
    private ElementReference _runtimeDialogTrigger;
    private FluentDialog _runtimeDialog = default!;
    private const string ClosedDialogState = "closed";
    private string _statusText = "Connecting…";
    private string _statusClass = string.Empty;
    private string? _bannerKind;
    private string? _bannerText;
    private CancellationTokenSource? _autoRefreshCancellation;

    private string WorkspaceCss => _mobileDetailsOpen ? "shell mobile-reading" : "shell mobile-list";
    private string StatusCss => string.IsNullOrWhiteSpace(_statusClass)
        ? "connection"
        : $"connection {_statusClass}";
    private string BannerCss => string.IsNullOrWhiteSpace(_bannerText)
        ? "notice"
        : $"notice show {_bannerKind}";
    private string BannerRole => string.Equals(_bannerKind, "err", StringComparison.Ordinal)
        ? "alert"
        : "status";
    private string? AccessToken => string.IsNullOrWhiteSpace(_bearerToken)
        ? null
        : _bearerToken.Trim();
    private string PreviewLimitLabel => $"{FormatBytes(TraceOptions.Value.MaxPreviewBytes)} preview";
    private int SuccessfulTraceCount => _traces.Count(trace => trace.IsSuccess is true);
    private int FailedTraceCount => _traces.Count(trace => trace.IsSuccess is false);
    private int StreamingTraceCount => _traces.Count(trace => trace.IsStreaming);
    private int CacheTraceCount => _traces.Count(HasCacheActivity);
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_search)
        || !string.IsNullOrWhiteSpace(_providerFilter)
        || !string.IsNullOrWhiteSpace(_modelFilter)
        || !string.IsNullOrWhiteSpace(_outcomeFilter);
    private LlmTestServerProviderHttpTrace? SelectedTrace => _selectedRequestId is null
        ? null
        : _traces.FirstOrDefault(trace =>
            string.Equals(trace.RequestId, _selectedRequestId, StringComparison.Ordinal)
        );
    private IReadOnlyList<string> GetProviderOptions() => _traces
        .Select(trace => trace.ProviderId)
        .Where(provider => !string.IsNullOrWhiteSpace(provider))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();
    private IReadOnlyList<string> GetModelOptions() => _traces
        .Select(ModelName)
        .Where(model => model != "—")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.OrdinalIgnoreCase)
        .ToList();

    protected override void OnInitialized()
    {
        // `/?view=insights` deep-links straight to the traffic charts.
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        _insightsOpen = query.TryGetValue("view", out var view)
            && string.Equals(view.ToString(), "insights", StringComparison.OrdinalIgnoreCase);
        _mobileDetailsOpen = _insightsOpen;
        RefreshState();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
            StartAutoRefresh();
        }

        if (_restoreRuntimeTriggerFocus)
        {
            _restoreRuntimeTriggerFocus = false;
            await _runtimeDialogTrigger.FocusAsync();
        }
    }

    private Task RefreshAsync()
    {
        RefreshState();
        return Task.CompletedTask;
    }

    private async Task ResetAsync()
    {
        if (!Runtime.IsBearerTokenAccepted(AccessToken))
        {
            SetUnauthorizedState();
            return;
        }

        _resetting = true;
        try
        {
            TraceStore.Reset();
            await Runtime.ResetAsync();
            RefreshState();
            await CloseRuntimeDialogAsync();
            SetBanner("warn", "Runtime reset · scenarios, events and provider request traces were cleared.");
        }
        catch (Exception exception)
        {
            _statusClass = "err";
            _statusText = "Server error";
            SetBanner("err", $"Reset failed: {exception.Message}");
        }
        finally
        {
            _resetting = false;
        }
    }

    private Task SetAutoRefreshAsync(ChangeEventArgs args)
    {
        _autoRefresh = args.Value is true
            || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (_autoRefresh)
        {
            StartAutoRefresh();
        }
        else
        {
            StopAutoRefresh();
        }

        return Task.CompletedTask;
    }

    private async Task OpenRuntimeDialogAsync()
    {
        await _runtimeDialog.ShowAsync();
        _runtimeDialogHidden = false;
    }

    private async Task CloseRuntimeDialogAsync()
    {
        await _runtimeDialog.HideAsync();
        _runtimeDialogHidden = true;
        _restoreRuntimeTriggerFocus = true;
    }

    private void RuntimeDialogToggled(DialogToggleEventArgs args)
    {
        if (args.Id == _runtimeDialog.Id && string.Equals(args.NewState, ClosedDialogState, StringComparison.Ordinal))
        {
            _runtimeDialogHidden = true;
            _restoreRuntimeTriggerFocus = true;
        }
    }

    private void RefreshState()
    {
        _statusText = "Loading…";
        if (!Runtime.IsBearerTokenAccepted(AccessToken))
        {
            SetUnauthorizedState();
            return;
        }

        _models = Runtime.GetModels();
        _summary = Runtime.GetAssertionSummary();
        _events = _summary.Events;
        var eventsByRequestId = new Dictionary<string, LlmTestServerRuntimeEvent>(StringComparer.Ordinal);
        foreach (var runtimeEvent in _events)
        {
            if (!string.IsNullOrWhiteSpace(runtimeEvent.RequestId))
            {
                eventsByRequestId[runtimeEvent.RequestId] = runtimeEvent;
            }
        }

        _eventsByRequestId = eventsByRequestId;
        _evidenceSnapshot = TraceStore.GetEvidenceSnapshot();
        _traces = _evidenceSnapshot.Requests;
        _providerColors = LlmTestServerDashboardInsights.CategoricalColors(_traces, trace => trace.ProviderId);
        if (_selectedRequestId is null
            || !_traces.Any(trace =>
                string.Equals(trace.RequestId, _selectedRequestId, StringComparison.Ordinal)
            ))
        {
            _selectedRequestId = _traces.FirstOrDefault()?.RequestId;
            _activeDetailTab = _overviewTab;
            if (_selectedRequestId is null)
            {
                _mobileDetailsOpen = false;
            }
        }

        _statusClass = "ok";
        _statusText = _traces.Any(trace => !trace.IsCompleted) ? "Requests in flight" : "Ready";
        ClearBanner();
    }

    private void SetUnauthorizedState()
    {
        _models = [];
        _traces = [];
        _evidenceSnapshot = new();
        _analyticsConversation = false;
        _events = [];
        _eventsByRequestId = new Dictionary<string, LlmTestServerRuntimeEvent>(StringComparer.Ordinal);
        _summary = new LlmTestServerAssertionSummary();
        _selectedRequestId = null;
        _mobileDetailsOpen = false;
        _statusClass = "err";
        _statusText = "Unauthorized";
        SetBanner("err", "Enter the configured bearer token to load runtime state and request traces.");
    }

    private void StartAutoRefresh()
    {
        StopAutoRefresh();
        if (!_autoRefresh)
        {
            return;
        }

        var cancellation = new CancellationTokenSource();
        _autoRefreshCancellation = cancellation;
        _ = RunAutoRefreshAsync(cancellation.Token);
    }

    private void StopAutoRefresh()
    {
        var cancellation = _autoRefreshCancellation;
        _autoRefreshCancellation = null;
        if (cancellation is null)
        {
            return;
        }

        cancellation.Cancel();
        cancellation.Dispose();
    }

    private async Task RunAutoRefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(_autoRefreshInterval);
            while (await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(false))
            {
                await InvokeAsync(() =>
                {
                    RefreshState();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (ObjectDisposedException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private IReadOnlyList<LlmTestServerProviderHttpTrace> FilterTraces()
    {
        IEnumerable<LlmTestServerProviderHttpTrace> query = _traces;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var search = _search.Trim();
            query = query.Where(trace => TraceContains(trace, search));
        }

        if (!string.IsNullOrWhiteSpace(_providerFilter))
        {
            query = query.Where(trace =>
                string.Equals(trace.ProviderId, _providerFilter, StringComparison.OrdinalIgnoreCase)
            );
        }

        if (!string.IsNullOrWhiteSpace(_modelFilter))
        {
            query = query.Where(trace =>
                string.Equals(ModelName(trace), _modelFilter, StringComparison.OrdinalIgnoreCase)
            );
        }

        query = _outcomeFilter switch
        {
            "success" => query.Where(trace => trace.IsSuccess is true),
            "error" => query.Where(trace => trace.IsSuccess is false),
            "stream" => query.Where(trace => trace.IsStreaming),
            "cache" => query.Where(HasCacheActivity),
            _ => query,
        };
        return query.ToList();
    }

    private static bool TraceContains(LlmTestServerProviderHttpTrace trace, string search)
    {
        return Contains(trace.ProviderId, search)
            || Contains(trace.Path, search)
            || Contains(trace.OperationId, search)
            || Contains(trace.ModelId, search)
            || Contains(trace.RequestPreview, search)
            || Contains(trace.ResponsePreview, search)
            || Contains(trace.RuntimeResponse, search)
            || Contains(trace.RuntimeMessage, search);
    }

    private static bool Contains(string? value, string search)
    {
        return value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _providerFilter = string.Empty;
        _modelFilter = string.Empty;
        _outcomeFilter = string.Empty;
    }

    private void SetOutcomeFilter(string filter)
    {
        _outcomeFilter = filter;
    }

    private bool IsOutcomeFilter(string filter)
    {
        return string.Equals(_outcomeFilter, filter, StringComparison.Ordinal);
    }

    private string RailFilterCss(string filter)
    {
        return IsOutcomeFilter(filter) ? "rail-item selected" : "rail-item";
    }

    private void SetProviderFilter(string provider)
    {
        _providerFilter = provider;
    }

    private bool IsProviderFilter(string provider)
    {
        return string.Equals(_providerFilter, provider, StringComparison.OrdinalIgnoreCase);
    }

    private string ProviderFilterCss(string provider)
    {
        return IsProviderFilter(provider) ? "rail-item provider selected" : "rail-item provider";
    }

    private int ProviderTraceCount(string provider)
    {
        return _traces.Count(trace =>
            string.Equals(trace.ProviderId, provider, StringComparison.OrdinalIgnoreCase)
        );
    }

    private void SelectTrace(string requestId)
    {
        _insightsOpen = false;
        _selectedRequestId = requestId;
        _activeDetailTab = _overviewTab;
        _mobileDetailsOpen = true;
    }

    private void BackToRequests()
    {
        _mobileDetailsOpen = false;
    }

    private bool IsSelected(LlmTestServerProviderHttpTrace trace)
    {
        return string.Equals(trace.RequestId, _selectedRequestId, StringComparison.Ordinal);
    }

    private string InboxItemCss(LlmTestServerProviderHttpTrace trace)
    {
        return IsSelected(trace) ? "inbox-item selected" : "inbox-item";
    }

    private static bool HasCacheActivity(LlmTestServerProviderHttpTrace trace)
    {
        return trace.Usage is { } usage
            && (usage.CachedInputTokens > 0 || usage.CacheCreationInputTokens > 0);
    }

    private bool IsDetailTab(string tab)
    {
        return string.Equals(_activeDetailTab, tab, StringComparison.Ordinal);
    }

    private string DetailTabCss(string tab)
    {
        return IsDetailTab(tab) ? "detail-tab selected" : "detail-tab";
    }

    private string DetailPanelCss(string tab)
    {
        return IsDetailTab(tab) ? "detail-panel active" : "detail-panel";
    }

    private void SetDetailTab(string tab)
    {
        _activeDetailTab = tab;
    }

    private static string AnalyticsValue(long value, LlmTestServerDashboardAnalytics analytics)
        => analytics.UsageRequestCount > 0 ? value.ToString(CultureInfo.InvariantCulture) : string.Empty;

    private static string AnalyticsNumber(long value, LlmTestServerDashboardAnalytics analytics)
        => analytics.UsageRequestCount > 0 ? value.ToString("N0", CultureInfo.InvariantCulture) : "—";

    private static string AnalyticsRatioValue(decimal? value) => value?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    private static string AnalyticsPercent(decimal? value) => value?.ToString("0.0%", CultureInfo.InvariantCulture) ?? "N/A";

    private static string AnalyticsShare(long value, long total)
        => total > 0 ? LlmTestServerDashboardCharts.Percent((double)value / total) : string.Empty;

    private static string TimelineHeight(long tokens, long max)
        => $"{LlmTestServerDashboardCharts.Number(Math.Max(3, tokens * 100d / max))}%";

    private static string ToolMeterWidth(int count, int max)
        => $"{LlmTestServerDashboardCharts.Number(count * 100d / max)}%";

    private static string TimelineTitle(int index, LlmTestServerDashboardRequestPoint point)
    {
        var header = $"Request #{index + 1} · {point.ModelId ?? "unknown model"} · {point.StartedAt.ToLocalTime():HH:mm:ss}";
        return point.Usage is not { } usage
            ? $"{header}\nNo usage reported"
            : string.Create(CultureInfo.InvariantCulture,
                $"{header}\n{usage.TotalTokens:N0} tokens · {usage.InputTokens:N0} input ({usage.CachedInputTokens:N0} cache read, {usage.CacheCreationInputTokens:N0} cache write) · {usage.OutputTokens:N0} output");
    }

    private static IEnumerable<LlmTestServerDashboardSegment> TokenSpark(LlmTestServerTokenUsage usage)
    {
        var mix = usage.InputComposition is { } composition && composition.TotalTokens == usage.InputTokens
            ? new LlmTestServerDashboardAnalytics
            {
                SystemTokens = composition.SystemTokens,
                ToolDefinitionTokens = composition.ToolDefinitionTokens,
                UserTokens = composition.UserTokens,
                AssistantTokens = composition.AssistantTokens,
                ToolCallTokens = composition.ToolCallTokens,
                ToolResultTokens = composition.ToolResultTokens,
                OtherRoleTokens = composition.OtherTokens,
            }.InputMix
            : [new("not-itemized", "Input", usage.InputTokens, "var(--mix-not-itemized)")];
        return mix.Append(new("output", "Output", usage.OutputTokens, "var(--output-source)")).Where(part => part.Tokens > 0);
    }

    private static string TokenSparkTitle(LlmTestServerTokenUsage usage)
    {
        var total = Math.Max(1, usage.TotalTokens);
        return $"{LlmTestServerDashboardCharts.Tokens(usage.TotalTokens)} tokens\n" + string.Join("\n", TokenSpark(usage).Select(part =>
            $"{part.Label} · {LlmTestServerDashboardCharts.Tokens(part.Tokens)} · {LlmTestServerDashboardCharts.Percent((double)part.Tokens / total)}"));
    }

    private static string NodeTip(LlmTestServerSankeyNode node)
    {
        return $"{node.Segment.Label}\n{LlmTestServerDashboardCharts.Tokens(node.Segment.Tokens)} tokens · {LlmTestServerDashboardCharts.Percent(node.Share)}";
    }

    private static string ArcTip(LlmTestServerDonutArc arc)
    {
        return $"{arc.Segment.Label}\n{LlmTestServerDashboardCharts.Tokens(arc.Segment.Tokens)} · {LlmTestServerDashboardCharts.Percent(arc.Share)}";
    }

    private static string SegmentTip(LlmTestServerDashboardSegment segment, long total)
    {
        return total > 0
            ? $"{segment.Label}\n{LlmTestServerDashboardCharts.Tokens(segment.Tokens)} · {LlmTestServerDashboardCharts.Percent((double)segment.Tokens / total)}"
            : $"{segment.Label}\n{LlmTestServerDashboardCharts.Tokens(segment.Tokens)}";
    }

    private string RailTip(string label, int count)
    {
        return $"{label}\n{count} of {_traces.Count} requests · {LlmTestServerDashboardCharts.Percent(_traces.Count == 0 ? 0 : (double)count / _traces.Count)}";
    }

    private readonly System.Runtime.CompilerServices.ConditionalWeakTable<LlmTestServerMessage, StrongBox<int>> _messageTokens = new();

    private int MessageTokens(LlmTestServerMessage message)
    {
        // Mirrors the runtime's per-message accounting so the bars add up to the reported input.
        return _messageTokens.GetValue(message, static item => new StrongBox<int>(LlmTestServerTokenCounter.CountTextTokens(
            item.ToolCalls.Count == 0 && item.ToolCallId is null
                ? item.Content
                : item.Content + " " + item.ToolCallId + " " + string.Join(" ", item.ToolCalls.Select(call => call.Id + " " + call.Name + " " + call.ArgumentsJson))))).Value;
    }

    private static RenderFragment MessageBody(LlmTestServerMessage message, string css) => __builder =>
    {
        // Tool results are usually JSON; show them like the wire payloads instead of a single long line.
        var content = message.Content.TrimStart();
        if ((message.ToolCallId is not null || string.Equals(message.Role, "tool", StringComparison.OrdinalIgnoreCase))
            && content.Length > 1 && content[0] is '{' or '[')
        {
            <pre class="@($"{css} tool-json")">@LlmTestServerJsonHighlighter.Highlight(message.Content, false)</pre>
        }
        else
        {
            <div class="@css">@message.Content</div>
        }
    };

    private static string RoleLabel(LlmTestServerMessage message)
    {
        return message.ToolCalls.Count > 0 ? $"{message.Role} · tool call" : message.Role;
    }

    private static string RoleColor(LlmTestServerMessage message)
    {
        if (message.ToolCallId is not null || string.Equals(message.Role, "tool", StringComparison.OrdinalIgnoreCase))
        {
            return "var(--mix-tool-results)";
        }

        return message.Role.ToLowerInvariant() switch
        {
            "system" or "developer" => "var(--mix-system)",
            "user" => "var(--mix-user)",
            "assistant" or "model" or "chatbot" => message.ToolCalls.Count > 0 && string.IsNullOrWhiteSpace(message.Content)
                ? "var(--mix-tool-calls)"
                : "var(--mix-assistant)",
            _ => "var(--mix-other)",
        };
    }

    private RenderFragment ConversationStrip(IReadOnlyList<LlmTestServerMessage> messages, LlmTestServerTokenUsage? usage) => __builder =>
    {
        if (messages.Count == 0)
        {
            return;
        }

        var schemas = usage?.InputComposition is { } composition && composition.TotalTokens == usage.InputTokens ? composition.ToolDefinitionTokens : 0;
        var total = Math.Max(1, messages.Sum(MessageTokens) + schemas);
        <div class="convo-strip" data-testid="conversation-strip">
          <div class="convo-strip-bar" role="img" aria-label="@($"Request context: {messages.Count} messages, {LlmTestServerDashboardCharts.Tokens(total)} tokens")">
            @for (var index = 0; index < messages.Count; index++)
            {
              var message = messages[index];
              <span style="flex-grow: @Math.Max(1, MessageTokens(message)); background: @RoleColor(message)" data-tip="@($"#{index + 1} {RoleLabel(message)}\n{LlmTestServerDashboardCharts.Tokens(MessageTokens(message))} tokens · {LlmTestServerDashboardCharts.Percent((double)MessageTokens(message) / total)}")" data-tip-color="@RoleColor(message)"></span>
            }
            @if (schemas > 0)
            {
              <span style="flex-grow: @schemas; background: var(--mix-tool-definitions)" data-tip="@($"Tool schemas\n{LlmTestServerDashboardCharts.Tokens(schemas)} tokens · {LlmTestServerDashboardCharts.Percent((double)schemas / total)}")" data-tip-color="var(--mix-tool-definitions)"></span>
            }
          </div>
          <div class="convo-strip-caption"><span>@messages.Count messages@(schemas > 0 ? " + tool schemas" : string.Empty)</span><strong>@LlmTestServerDashboardCharts.Tokens(total) tokens</strong></div>
        </div>
    };

    private RenderFragment MessageMeter(LlmTestServerMessage message, IReadOnlyList<LlmTestServerMessage> messages) => __builder =>
    {
        var tokens = MessageTokens(message);
        var max = Math.Max(1, messages.Max(MessageTokens));
        <span class="msg-meter" data-tip="@($"{RoleLabel(message)}\n{LlmTestServerDashboardCharts.Tokens(tokens)} tokens · {FormatCharacterCount(message.Content)}")" data-tip-color="@RoleColor(message)"><span class="msg-meter-bar"><span style="width: @ToolMeterWidth(tokens, max); background: @RoleColor(message)"></span></span><span class="msg-meter-value">@LlmTestServerDashboardCharts.Tokens(tokens) tok</span></span>
    };

    private static RenderFragment SizeMeter(long bytes, long max) => __builder =>
    {
        <span class="size-meter"><span class="size-meter-bar"><span style="width: @LlmTestServerDashboardCharts.Number(max > 0 ? Math.Max(2, bytes * 100d / max) : 0)%"></span></span><span>@FormatBytes(bytes)</span></span>
    };

    private string RailShare(int count)
    {
        return LlmTestServerDashboardCharts.Number(_traces.Count == 0 ? 0 : (double)count / _traces.Count);
    }

