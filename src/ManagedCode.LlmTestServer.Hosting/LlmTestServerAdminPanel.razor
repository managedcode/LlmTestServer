    private string ModelName(LlmTestServerProviderHttpTrace trace)
    {
        return string.IsNullOrWhiteSpace(trace.ModelId)
            ? RuntimeEventFor(trace)?.ModelId ?? "—"
            : trace.ModelId;
    }

    private string RequestPreview(LlmTestServerProviderHttpTrace trace)
    {
        var messages = MessagesFor(trace);
        var message = messages.LastOrDefault(candidate =>
                string.Equals(candidate.Role, "user", StringComparison.OrdinalIgnoreCase)
            )
            ?? messages.LastOrDefault();
        if (message is not null && !string.IsNullOrWhiteSpace(message.Content))
        {
            return TurnPreview(message.Content);
        }

        return !string.IsNullOrWhiteSpace(trace.OperationId)
            ? trace.OperationId
            : trace.Path;
    }

    private static string ProviderInitial(string providerId)
    {
        return ProviderName(providerId) switch
        {
            "Azure OpenAI" => "Az",
            "Microsoft Foundry" => "M",
            "Amazon Bedrock" => "B",
            "OpenRouter" => "Or",
            "DeepSeek" => "D",
            "Perplexity" => "P",
            { Length: > 0 } name => name[..1],
            _ => "?",
        };
    }

    private static bool ShouldCollapseTurn(string role, string content)
    {
        return content.Length > _collapsedTurnThreshold
            && (string.Equals(role, "system", StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, "tool", StringComparison.OrdinalIgnoreCase));
    }

    private static string TurnPreview(string content)
    {
        var builder = new StringBuilder(Math.Min(content.Length, _turnPreviewLimit + 1));
        var pendingSpace = false;
        var truncated = false;
        foreach (var character in content)
        {
            if (char.IsWhiteSpace(character))
            {
                pendingSpace = builder.Length > 0;
                continue;
            }

            if (pendingSpace)
            {
                if (builder.Length >= _turnPreviewLimit)
                {
                    truncated = true;
                    break;
                }

                builder.Append(' ');
                pendingSpace = false;
            }

            if (builder.Length >= _turnPreviewLimit)
            {
                truncated = true;
                break;
            }

            builder.Append(character);
        }

        return truncated ? builder.Append('…').ToString() : builder.ToString();
    }

    private static string FormatCharacterCount(string content)
    {
