        return IsDetailTab(tab) ? "detail-panel active" : "detail-panel";
    }

    private void SetDetailTab(string tab)
    {
        _activeDetailTab = tab;
    }

    private LlmTestServerRuntimeEvent? RuntimeEventFor(LlmTestServerProviderHttpTrace trace)
    {
        return _eventsByRequestId.GetValueOrDefault(trace.RequestId);
    }

    private LlmTestServerTokenUsage? UsageFor(LlmTestServerProviderHttpTrace trace)
    {
        return trace.Usage ?? RuntimeEventFor(trace)?.Usage;
    }

    private IReadOnlyList<LlmTestServerMessage> MessagesFor(LlmTestServerProviderHttpTrace trace)
    {
        return trace.Messages.Count > 0
            ? trace.Messages
            : RuntimeEventFor(trace)?.Messages ?? [];
    }

    private IReadOnlyList<string> ChunksFor(LlmTestServerProviderHttpTrace trace)
    {
        return trace.StreamChunks.Count > 0
            ? trace.StreamChunks
            : RuntimeEventFor(trace)?.StreamChunks ?? [];
    }

    private string ModelName(LlmTestServerProviderHttpTrace trace)
    {
        return string.IsNullOrWhiteSpace(trace.ModelId)
            ? RuntimeEventFor(trace)?.ModelId ?? "—"
            : trace.ModelId;
    }

    private string RequestPreview(LlmTestServerProviderHttpTrace trace)
    {
        var messages = MessagesFor(trace);
        var message = messages.LastOrDefault(candidate =>
                string.Equals(candidate.Role, "user", StringComparison.OrdinalIgnoreCase)
            )
            ?? messages.LastOrDefault();
        if (message is not null && !string.IsNullOrWhiteSpace(message.Content))
        {
            return TurnPreview(message.Content);
        }

        return !string.IsNullOrWhiteSpace(trace.OperationId)
            ? trace.OperationId
            : trace.Path;
    }

    private static string ProviderInitial(string providerId)
    {
        return ProviderName(providerId) switch
        {
            "Azure OpenAI" => "Az",
            "Microsoft Foundry" => "M",
            "Amazon Bedrock" => "B",
            "OpenRouter" => "Or",
            "DeepSeek" => "D",
            "Perplexity" => "P",
            { Length: > 0 } name => name[..1],
            _ => "?",
        };
    }

    private static bool ShouldCollapseTurn(string role, string content)
    {
        return content.Length > _collapsedTurnThreshold
            && (string.Equals(role, "system", StringComparison.OrdinalIgnoreCase)
                || string.Equals(role, "tool", StringComparison.OrdinalIgnoreCase));
    }

    private static string TurnPreview(string content)
    {
        var builder = new StringBuilder(Math.Min(content.Length, _turnPreviewLimit + 1));
        var pendingSpace = false;
        var truncated = false;
        foreach (var character in content)
        {
            if (char.IsWhiteSpace(character))
            {
                pendingSpace = builder.Length > 0;
                continue;
            }

            if (pendingSpace)
            {
                if (builder.Length >= _turnPreviewLimit)
                {
                    truncated = true;
                    break;
                }

                builder.Append(' ');
                pendingSpace = false;
            }

            if (builder.Length >= _turnPreviewLimit)
            {
                truncated = true;
                break;
            }

            builder.Append(character);
        }

        return truncated ? builder.Append('…').ToString() : builder.ToString();
    }

    private static string FormatCharacterCount(string content)
    {
        return $"{content.Length.ToString("N0", CultureInfo.InvariantCulture)} chars";
    }

    private static string ProviderName(string providerId)
    {
        return providerId switch
        {
            LlmTestServerCompatibilityTags.OpenAI => "OpenAI",
            LlmTestServerCompatibilityTags.AzureOpenAI => "Azure OpenAI",
            LlmTestServerCompatibilityTags.MicrosoftFoundry => "Microsoft Foundry",
            LlmTestServerCompatibilityTags.Anthropic => "Anthropic",
            LlmTestServerCompatibilityTags.Gemini => "Gemini",
            LlmTestServerCompatibilityTags.Groq => "Groq",
            LlmTestServerCompatibilityTags.Mistral => "Mistral",
            LlmTestServerCompatibilityTags.Ollama => "Ollama",
            LlmTestServerCompatibilityTags.Cohere => "Cohere",
            LlmTestServerCompatibilityTags.Bedrock => "Amazon Bedrock",
            LlmTestServerCompatibilityTags.OpenRouter => "OpenRouter",
            LlmTestServerCompatibilityTags.DeepSeek => "DeepSeek",
            LlmTestServerCompatibilityTags.Perplexity => "Perplexity",
            _ => string.IsNullOrWhiteSpace(providerId) ? "Unknown" : providerId,
        };
    }

    private static string StatusCssFor(LlmTestServerProviderHttpTrace trace)
    {
        if (!trace.IsCompleted)
        {
            return "status-chip warning";
        }

        if (trace.TransportState != LlmTestServerProviderHttpTraceTransportState.Completed)
        {
            return "status-chip error";
        }

        return trace.StatusCode switch
        {
            null => "status-chip error",
            < 400 => "status-chip success",
            >= 400 => "status-chip error",
        };
    }

    private static string StatusText(LlmTestServerProviderHttpTrace trace)
    {
        if (!trace.IsCompleted)
        {
            return "Running";
        }

        if (trace.TransportState != LlmTestServerProviderHttpTraceTransportState.Completed)
        {
            return trace.TransportState.ToString();
        }

        return trace.StatusCode switch
        {
            null => "No status",
            200 => "200 OK",
            201 => "201 Created",
            202 => "202 Accepted",
            204 => "204 Empty",
            400 => "400 Invalid",
            401 => "401 Auth",
            404 => "404 Missing",
            405 => "405 Method",
            409 => "409 Conflict",
            429 => "429 Limited",
            >= 500 => $"{trace.StatusCode} Server",
            _ => trace.StatusCode.Value.ToString(CultureInfo.InvariantCulture),
        };
    }

    private static string InboxStatusText(LlmTestServerProviderHttpTrace trace)
    {
        if (!trace.IsCompleted)
        {
            return "Live";
        }

        return trace.StatusCode?.ToString(CultureInfo.InvariantCulture)
            ?? trace.TransportState.ToString();
    }

    private static string FormatDuration(double? milliseconds)
    {
        if (milliseconds is null)
        {
            return "running";
        }

        return milliseconds < 1
            ? "<1 ms"
            : $"{milliseconds.Value:N0} ms";
    }

    private static string FormatBytes(long? bytes)
    {
        if (bytes is null)
        {
            return "unknown";
        }

        if (bytes < 1024)
        {
            return $"{bytes.Value:N0} B";
        }

        return $"{bytes.Value / 1024d:N1} KiB";
    }

    private static string TurnCss(string role)
    {
        if (string.Equals(role, "system", StringComparison.OrdinalIgnoreCase))
        {
            return "turn system";
        }

        if (string.Equals(role, "user", StringComparison.OrdinalIgnoreCase))
        {
            return "turn user";
        }

        if (string.Equals(role, "assistant", StringComparison.OrdinalIgnoreCase))
        {
            return "turn assistant";
        }

        return string.Equals(role, "tool", StringComparison.OrdinalIgnoreCase)
            ? "turn tool"
            : "turn";
    }

    private static string RuntimeResponseTurnCss(LlmTestServerProviderHttpTrace trace)
    {
        return trace.RuntimeEventKind == LlmTestServerEventKind.ErrorReturned
            ? "turn error"
            : "turn assistant";
    }

    private static string RuntimeResponseRole(LlmTestServerProviderHttpTrace trace)
    {
        if (trace.IsSuccess is false || trace.RuntimeEventKind == LlmTestServerEventKind.ErrorReturned)
        {
            return "provider error";
        }

        return string.IsNullOrWhiteSpace(trace.RuntimeResponse)
            ? "provider response"
            : "assistant";
    }

    private static string AriaBoolean(bool value)
    {
        return value ? "true" : "false";
    }

    private static string EventTone(LlmTestServerEventKind kind)
    {
        return kind switch
        {
            LlmTestServerEventKind.Matched => "success",
            LlmTestServerEventKind.Unmatched
                or LlmTestServerEventKind.ScenarioExhausted => "warning",
            _ => "error",
        };
    }

    private static string PrettyPayload(string? payload, bool truncated)
    {
        if (string.IsNullOrWhiteSpace(payload))
        {
            return "No body captured.";
        }

        var suffix = truncated ? "\n\n[preview truncated]" : string.Empty;
        try
        {
            using var document = JsonDocument.Parse(payload);
            return JsonSerializer.Serialize(document.RootElement, _prettyJsonOptions) + suffix;
        }
        catch (JsonException)
        {
            return payload + suffix;
        }
    }

    private static string Empty(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "—" : value;
    }

    private void SetBanner(string kind, string text)
    {
        _bannerKind = kind;
        _bannerText = text;
    }

    private void ClearBanner()
    {
        _bannerKind = null;
        _bannerText = null;
    }

    public ValueTask DisposeAsync()
    {
        StopAutoRefresh();
        return ValueTask.CompletedTask;
    }

    private sealed record ProviderRoute(string Name, string Route);
}
